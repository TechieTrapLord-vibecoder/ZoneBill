@model IEnumerable<ZoneBill_Lloren.Models.Payment>
@using ZoneBill_Lloren.Helpers

@{
    ViewData["Title"] = "Payments";
}

@{
    var totalCollected = (decimal)(ViewBag.TotalCollected ?? 0m);
    var cashCount = (int)(ViewBag.CashCount ?? 0);
    var gcashCount = (int)(ViewBag.GCashCount ?? 0);
    var cardCount = (int)(ViewBag.CardCount ?? 0);
    var search = ViewBag.Search as string;
    var paymentMethod = ViewBag.PaymentMethod as string;
    var fromDate = ViewBag.FromDate as string;
    var toDate = ViewBag.ToDate as string;
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalCount2 = (int)(ViewBag.TotalCount ?? 0);
    string PageUrl(int nextPage) => Url.Action("Index", new { search, paymentMethod, fromDate, toDate, page = nextPage }) ?? "#";
    var paging = new ZoneBill_Lloren.Models.PagingInfo { CurrentPage = currentPage, TotalPages = totalPages, TotalCount = totalCount2, UrlTemplate = PageUrl(0).Replace("page=0", "page=__PAGE__") };
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-0" style="color:var(--zb-text);"><i class="bi bi-cash-coin me-2" style="color:var(--zb-secondary);"></i>Payments</h4>
        <p class="text-muted small mb-0">All collected payments across invoices.</p>
    </div>
    <span class="zb-badge" style="background:rgba(6,182,212,0.12);color:var(--zb-secondary);border:1px solid rgba(6,182,212,0.3);">
        <i class="bi bi-robot me-1"></i>Auto-recorded from checkout
    </span>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="zb-kpi-card" style="border-color:rgba(6,182,212,0.4);">
            <div class="zb-kpi-label">Total Collected</div>
            <div class="zb-kpi-value" style="color:var(--zb-secondary);">₱@totalCollected.ToString("N2")</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="zb-kpi-card">
            <div class="zb-kpi-label">Cash</div>
            <div class="zb-kpi-value">@cashCount</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="zb-kpi-card" style="border-color:rgba(249,115,22,0.4);">
            <div class="zb-kpi-label">GCash</div>
            <div class="zb-kpi-value" style="color:var(--zb-accent);">@gcashCount</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="zb-kpi-card" style="border-color:rgba(139,92,246,0.4);">
            <div class="zb-kpi-label">Card</div>
            <div class="zb-kpi-value" style="color:#a78bfa;">@cardCount</div>
        </div>
    </div>
</div>

<form method="get" class="zb-table-card p-3 mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label small" style="color:var(--zb-text-muted);">Search</label>
            <input type="text" name="search" value="@search" class="form-control zb-form-input" placeholder="Invoice ID, method, reference" />
        </div>
        <div class="col-md-3">
            <label class="form-label small" style="color:var(--zb-text-muted);">Payment Method</label>
            <select name="paymentMethod" class="form-select zb-form-input">
                <option value="">All methods</option>
                <option value="Cash" selected="@(paymentMethod == "Cash" ? "selected" : null)">Cash</option>
                <option value="GCash" selected="@(paymentMethod == "GCash" ? "selected" : null)">GCash</option>
                <option value="Card" selected="@(paymentMethod == "Card" ? "selected" : null)">Card</option>
                <option value="Manual" selected="@(paymentMethod == "Manual" ? "selected" : null)">Manual</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small" style="color:var(--zb-text-muted);">From</label>
            <input type="date" name="fromDate" value="@fromDate" class="form-control zb-form-input" />
        </div>
        <div class="col-md-2">
            <label class="form-label small" style="color:var(--zb-text-muted);">To</label>
            <input type="date" name="toDate" value="@toDate" class="form-control zb-form-input" />
        </div>
        <div class="col-md-1 d-grid">
            <button type="submit" class="btn btn-sm fw-semibold" style="background:rgba(6,182,212,0.15);color:var(--zb-secondary);border:1px solid rgba(6,182,212,0.3);">Go</button>
        </div>
    </div>
</form>

<div class="zb-table-card">
    <div class="table-responsive">
        <table class="table zb-table mb-0">
            <thead>
                <tr>
                    <th>Business</th>
                    <th>Invoice Status</th>
                    <th>Amount Paid</th>
                    <th>Method</th>
                    <th>Date</th>
                    <th>Reference</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var methodClass = item.PaymentMethod == "Cash" ? "zb-badge-cyan" :
                                     item.PaymentMethod == "GCash" ? "zb-badge-orange" : "zb-badge-purple";
                    <tr>
                        <td class="fw-semibold" style="color:var(--zb-text);">@item.Business?.BusinessName</td>
                        <td>@item.Invoice?.PaymentStatus</td>
                        <td class="fw-semibold" style="color:var(--zb-secondary);">₱@item.AmountPaid.ToString("N2")</td>
                        <td><span class="zb-badge @methodClass">@item.PaymentMethod</span></td>
                        <td><span class="zb-mono">@PhilippineTime.ToDateTime(item.PaymentDate).ToString("MMM d, h:mm tt")</span></td>
                        <td><span class="text-muted zb-mono">@(string.IsNullOrEmpty(item.ReferenceNumber) ? "—" : item.ReferenceNumber)</span></td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Details" asp-route-id="@item.PaymentId" class="zb-action-btn" title="View"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@item.PaymentId" class="zb-action-btn" title="Edit"><i class="bi bi-pencil"></i></a>
                                @if (User.IsInRole("MainAdmin") || User.IsInRole("Manager"))
                                {
                                    <button type="button" class="zb-action-btn zb-action-danger" title="Void Payment"
                                            onclick="openVoidModal(@item.PaymentId, '@item.PaymentMethod', '@item.AmountPaid.ToString("N2")')">
                                        <i class="bi bi-slash-circle"></i>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination", paging)
</div>

@if (User.IsInRole("MainAdmin") || User.IsInRole("Manager"))
{
    <!-- Void Payment Modal -->
    <div class="modal fade" id="voidPaymentModal" tabindex="-1" aria-labelledby="voidPaymentModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0" style="background:var(--zb-card);color:var(--zb-text);">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="voidPaymentModalLabel" style="color:var(--zb-accent);">
                        <i class="bi bi-slash-circle me-2"></i>Void Payment
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3" style="color:var(--zb-text-muted);">
                        You are about to void <strong id="voidPaymentDesc" style="color:var(--zb-text);"></strong>.
                        The invoice will be reset to <span class="zb-badge zb-badge-orange">Unpaid</span> and a reversing journal entry will be created.
                    </p>
                    <label class="form-label fw-semibold small" style="color:var(--zb-text-muted);">Reason (optional)</label>
                    <input type="text" id="voidReason" class="form-control zb-input" placeholder="e.g. Customer dispute, duplicate payment…" maxlength="200" />
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-sm fw-semibold" data-bs-dismiss="modal"
                            style="background:rgba(255,255,255,0.06);color:var(--zb-text-muted);border:1px solid rgba(255,255,255,0.1);">Cancel</button>
                    <form id="voidPaymentForm" method="post" action="">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="voidReasonHidden" name="reason" value="" />
                        <button type="submit" class="btn btn-sm fw-semibold"
                                style="background:rgba(239,68,68,0.15);color:#f87171;border:1px solid rgba(239,68,68,0.3);">
                            <i class="bi bi-slash-circle me-1"></i>Confirm Void
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        function openVoidModal(paymentId, method, amount) {
            document.getElementById('voidPaymentDesc').textContent = 'Payment #' + paymentId + ' (' + method + ' ₱' + amount + ')';
            document.getElementById('voidPaymentForm').action = '@Url.Action("Void", "Payments")/' + paymentId;
            document.getElementById('voidReason').value = '';
            var modal = new bootstrap.Modal(document.getElementById('voidPaymentModal'));
            modal.show();
        }

        document.getElementById('voidPaymentForm').addEventListener('submit', function () {
            document.getElementById('voidReasonHidden').value = document.getElementById('voidReason').value;
        });
    </script>
}
