@model ZoneBill_Lloren.Models.Booking

@{
    ViewData["Title"] = "Booking Details";
    var statusColor = Model.BookingStatus == "Active" ? "#06b6d4" :
                      Model.BookingStatus == "Completed" ? "#22c55e" : "#ef4444";
    var statusBg = Model.BookingStatus == "Active" ? "rgba(6,182,212,0.12)" :
                   Model.BookingStatus == "Completed" ? "rgba(34,197,94,0.12)" : "rgba(239,68,68,0.12)";
    var statusBorder = Model.BookingStatus == "Active" ? "rgba(6,182,212,0.3)" :
                       Model.BookingStatus == "Completed" ? "rgba(34,197,94,0.3)" : "rgba(239,68,68,0.3)";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1" style="color:var(--zb-text);">
            <i class="bi bi-calendar-check me-2" style="color:var(--zb-secondary);"></i>Booking Details
        </h4>
        <p class="text-muted small mb-0">Reference: <span class="zb-mono" style="color:var(--zb-secondary);">@Model.ReferenceCode</span></p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <span class="zb-badge fw-semibold px-3 py-2" style="background:@statusBg;color:@statusColor;border:1px solid @statusBorder;font-size:.85rem;">
            @Model.BookingStatus
        </span>
        <a asp-action="Index" class="btn btn-sm fw-semibold" style="background:rgba(6,182,212,0.12);color:var(--zb-secondary);border:1px solid rgba(6,182,212,0.3);">
            <i class="bi bi-arrow-left me-1"></i>Back to List
        </a>
    </div>
</div>

<div class="row g-4">
    @* Left column: core booking info *@
    <div class="col-lg-8">
        <div class="zb-table-card h-100">
            <div class="px-4 pt-3 pb-2 border-bottom" style="border-color:rgba(6,182,212,0.15)!important;">
                <h6 class="fw-bold mb-0" style="color:var(--zb-secondary);">
                    <i class="bi bi-info-circle me-2"></i>Booking Information
                </h6>
            </div>
            <div class="p-4">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="small mb-1" style="color:var(--zb-text-muted);">Business</div>
                        <div class="fw-semibold" style="color:var(--zb-text);">@(Model.Business?.BusinessName ?? "—")</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="small mb-1" style="color:var(--zb-text-muted);">Space / Table</div>
                        <div class="fw-semibold" style="color:var(--zb-text);">@(Model.Space?.SpaceName ?? "—")</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="small mb-1" style="color:var(--zb-text-muted);">Customer</div>
                        <div class="fw-semibold" style="color:var(--zb-text);">@(Model.Customer?.Name ?? "—")</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="small mb-1" style="color:var(--zb-text-muted);">Rate / Hour</div>
                        <div class="fw-semibold" style="color:var(--zb-secondary);">₱@Model.LockedHourlyRate.ToString("N2")</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="small mb-1" style="color:var(--zb-text-muted);">Start Time</div>
                        <div class="fw-semibold zb-mono" style="color:var(--zb-text);">@Model.StartTime.ToString("MMM dd, yyyy h:mm tt")</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="small mb-1" style="color:var(--zb-text-muted);">End Time</div>
                        <div class="fw-semibold zb-mono" style="color:var(--zb-text);">
                            @(Model.EndTime.HasValue ? Model.EndTime.Value.ToString("MMM dd, yyyy h:mm tt") : "—")
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="small mb-1" style="color:var(--zb-text-muted);">Duration</div>
                        <div class="fw-semibold" style="color:var(--zb-text);">
                            @(Model.DurationHours.HasValue ? $"{Model.DurationHours:0.##} hr" : "—")
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="small mb-1" style="color:var(--zb-text-muted);">Reference Code</div>
                        <div class="fw-semibold zb-mono" style="color:var(--zb-text-muted);">@(Model.ReferenceCode ?? "—")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Right column: status summary card *@
    <div class="col-lg-4">
        <div class="zb-table-card h-100">
            <div class="px-4 pt-3 pb-2 border-bottom" style="border-color:rgba(6,182,212,0.15)!important;">
                <h6 class="fw-bold mb-0" style="color:var(--zb-secondary);">
                    <i class="bi bi-bar-chart-line me-2"></i>Session Summary
                </h6>
            </div>
            <div class="p-4 d-flex flex-column gap-3">
                <div class="d-flex justify-content-between align-items-center p-3 rounded" style="background:rgba(6,182,212,0.07);border:1px solid rgba(6,182,212,0.15);">
                    <span class="small" style="color:var(--zb-text-muted);">Status</span>
                    <span class="fw-bold" style="color:@statusColor;">@Model.BookingStatus</span>
                </div>
                <div class="d-flex justify-content-between align-items-center p-3 rounded" style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);">
                    <span class="small" style="color:var(--zb-text-muted);">Hours</span>
                    <span class="fw-bold" style="color:var(--zb-text);">@(Model.DurationHours.HasValue ? $"{Model.DurationHours:0.##} hr" : "—")</span>
                </div>
                <div class="d-flex justify-content-between align-items-center p-3 rounded" style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);">
                    <span class="small" style="color:var(--zb-text-muted);">Rate/hr</span>
                    <span class="fw-bold" style="color:var(--zb-secondary);">₱@Model.LockedHourlyRate.ToString("N2")</span>
                </div>
                @if (Model.DurationHours.HasValue)
                {
                    var sessionTotal = Model.DurationHours.Value * Model.LockedHourlyRate;
                    <div class="d-flex justify-content-between align-items-center p-3 rounded" style="background:rgba(34,197,94,0.08);border:1px solid rgba(34,197,94,0.2);">
                        <span class="small fw-semibold" style="color:var(--zb-text-muted);">Session Total</span>
                        <span class="fw-bold" style="color:#22c55e;">₱@sessionTotal.ToString("N2")</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
