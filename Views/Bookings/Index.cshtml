@model IEnumerable<ZoneBill_Lloren.Models.Booking>

@{
    ViewData["Title"] = "Bookings";
}

@{
    var total = (int)(ViewBag.TotalBookings ?? 0);
    var active = (int)(ViewBag.ActiveBookings ?? 0);
    var completed = (int)(ViewBag.CompletedBookings ?? 0);
    var cancelled = (int)(ViewBag.CancelledBookings ?? 0);
    var search = ViewBag.Search as string;
    var status = ViewBag.Status as string;
    var fromDate = ViewBag.FromDate as string;
    var toDate = ViewBag.ToDate as string;
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    string PageUrl(int nextPage) => Url.Action("Index", new { search, status, fromDate, toDate, page = nextPage }) ?? "#";
    var paging = new ZoneBill_Lloren.Models.PagingInfo { CurrentPage = currentPage, TotalPages = totalPages, TotalCount = totalCount, UrlTemplate = PageUrl(0).Replace("page=0", "page=__PAGE__") };
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-0" style="color:var(--zb-text);"><i class="bi bi-calendar-check me-2" style="color:var(--zb-secondary);"></i>Bookings</h4>
        <p class="text-muted small mb-0">All reservation records for your venue.</p>
    </div>
    <span class="zb-badge" style="background:rgba(6,182,212,0.12);color:var(--zb-secondary);border:1px solid rgba(6,182,212,0.3);">
        <i class="bi bi-robot me-1"></i>Sessions started from POS
    </span>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="zb-kpi-card">
            <div class="zb-kpi-label">Total</div>
            <div class="zb-kpi-value">@total</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="zb-kpi-card" style="border-color:rgba(6,182,212,0.4);">
            <div class="zb-kpi-label">Active</div>
            <div class="zb-kpi-value" style="color:var(--zb-secondary);">@active</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="zb-kpi-card" style="border-color:rgba(34,197,94,0.4);">
            <div class="zb-kpi-label">Completed</div>
            <div class="zb-kpi-value" style="color:#22c55e;">@completed</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="zb-kpi-card" style="border-color:rgba(239,68,68,0.4);">
            <div class="zb-kpi-label">Cancelled</div>
            <div class="zb-kpi-value" style="color:#ef4444;">@cancelled</div>
        </div>
    </div>
</div>

<form method="get" class="zb-table-card p-3 mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label for="bookingsSearch" class="form-label small" style="color:var(--zb-text-muted);">Search</label>
            <input id="bookingsSearch" type="text" name="search" value="@search" class="form-control zb-form-input" placeholder="Booking ID, table, customer, reference" />
        </div>
        <div class="col-md-2">
            <label for="bookingsStatus" class="form-label small" style="color:var(--zb-text-muted);">Status</label>
            <select id="bookingsStatus" name="status" class="form-select zb-form-input">
                <option value="">All statuses</option>
                <option value="Active" selected="@(status == "Active" ? "selected" : null)">Active</option>
                <option value="Completed" selected="@(status == "Completed" ? "selected" : null)">Completed</option>
                <option value="Cancelled" selected="@(status == "Cancelled" ? "selected" : null)">Cancelled</option>
            </select>
        </div>
        <div class="col-md-2">
            <label for="bookingsFromDate" class="form-label small" style="color:var(--zb-text-muted);">From</label>
            <input id="bookingsFromDate" type="date" name="fromDate" value="@fromDate" class="form-control zb-form-input" />
        </div>
        <div class="col-md-2">
            <label for="bookingsToDate" class="form-label small" style="color:var(--zb-text-muted);">To</label>
            <input id="bookingsToDate" type="date" name="toDate" value="@toDate" class="form-control zb-form-input" />
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-sm fw-semibold flex-grow-1" style="background:rgba(6,182,212,0.15);color:var(--zb-secondary);border:1px solid rgba(6,182,212,0.3);">Apply</button>
            <a href="@Url.Action("Index")" class="btn btn-sm" style="background:rgba(255,255,255,0.06);color:var(--zb-text-muted);border:1px solid rgba(255,255,255,0.1);">Reset</a>
        </div>
    </div>
</form>

<div class="zb-table-card">
    <div class="table-responsive">
        <table class="table zb-table mb-0">
            <thead>
                <tr>
                    <th>Space</th>
                    <th>Customer</th>
                    <th>Start Time</th>
                    <th>End Time</th>
                    <th>Duration</th>
                    <th>Rate/hr</th>
                    <th>Status</th>
                    <th>Reference</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var statusClass = item.BookingStatus == "Active" ? "zb-badge-cyan" :
                                     item.BookingStatus == "Completed" ? "zb-badge-green" : "zb-badge-red";
                    <tr>
                        <td class="fw-semibold" style="color:var(--zb-text);">@item.Space?.SpaceName</td>
                        <td>@item.Customer?.Name</td>
                        <td><span class="zb-mono">@item.StartTime.ToString("MMM d, h:mm tt")</span></td>
                        <td><span class="zb-mono">@(item.EndTime.HasValue ? item.EndTime.Value.ToString("MMM d, h:mm tt") : "—")</span></td>
                        <td>@(item.DurationHours.HasValue ? $"{item.DurationHours:0.##} hr" : "—")</td>
                        <td>₱@item.LockedHourlyRate.ToString("0.00")</td>
                        <td><span class="zb-badge @statusClass">@item.BookingStatus</span></td>
                        <td><span class="zb-mono text-muted">@item.ReferenceCode</span></td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Details" asp-route-id="@item.BookingId" class="zb-action-btn"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@item.BookingId" class="zb-action-btn"><i class="bi bi-pencil"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination", paging)
</div>
