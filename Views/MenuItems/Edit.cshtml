@model ZoneBill_Lloren.Models.MenuItem

@{
    ViewData["Title"] = "Edit Menu Item";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0" style="color:var(--zb-text);"><i class="bi bi-pencil-square me-2" style="color:var(--zb-secondary);"></i>Edit Menu Item</h4>
    <a asp-action="Index" class="btn btn-sm fw-semibold" style="background:rgba(6,182,212,0.12);color:var(--zb-secondary);border:1px solid rgba(6,182,212,0.3);"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
</div>

<div class="zb-table-card">
    <div class="p-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="ItemId" />
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="BusinessId" class="form-label zb-form-label"></label>
                    <select asp-for="BusinessId" class="form-select zb-form-input" asp-items="ViewBag.BusinessId"></select>
                    <span asp-validation-for="BusinessId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ItemName" class="form-label zb-form-label"></label>
                    <input asp-for="ItemName" class="form-control zb-form-input" />
                    <span asp-validation-for="ItemName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Category" class="form-label zb-form-label"></label>
                    @{
                        var knownCats = new[] { "Food", "Beverages", "Snacks", "Desserts", "Add-ons", "Packages", "Services", "Merchandise" };
                        var isKnown = knownCats.Contains(Model.Category);
                        var customClass = isKnown ? "form-control zb-form-input mt-2 d-none" : "form-control zb-form-input mt-2";
                        var customValue = isKnown ? "" : Model.Category;
                    }
                    <select id="CategorySelect" name="Category" class="form-select zb-form-input" onchange="toggleCustomCategory(this)">
                        <option value="">-- Select Category --</option>
                        @foreach (var cat in knownCats)
                        {
                            if (Model.Category == cat)
                            {
                                <option value="@cat" selected="selected">@cat</option>
                            }
                            else
                            {
                                <option value="@cat">@cat</option>
                            }
                        }
                        @if (!isKnown)
                        {
                            <option value="__custom__" selected="selected">Other (type your own)</option>
                        }
                        else
                        {
                            <option value="__custom__">Other (type your own)</option>
                        }
                    </select>
                    <input type="text" id="CategoryCustom" name="_customCat"
                           class="@customClass"
                           placeholder="Type category name..."
                           value="@customValue" />
                    <span asp-validation-for="Category" class="text-danger small"></span>
                </div>
                <script>
                    function toggleCustomCategory(sel) {
                        var custom = document.getElementById('CategoryCustom');
                        if (sel.value === '__custom__') {
                            custom.classList.remove('d-none');
                            sel.name = '_ignoreCat';
                            custom.name = 'Category';
                            custom.focus();
                        } else {
                            custom.classList.add('d-none');
                            sel.name = 'Category';
                            custom.name = '_customCat';
                        }
                    }
                    (function () {
                        var sel = document.getElementById('CategorySelect');
                        var custom = document.getElementById('CategoryCustom');
                        if (sel && sel.value === '__custom__') {
                            sel.name = '_ignoreCat';
                            custom.name = 'Category';
                        }
                    })();
                </script>
                <div class="col-md-6">
                    <label asp-for="ImageUrl" class="form-label zb-form-label"></label>
                    <input asp-for="ImageUrl" class="form-control zb-form-input" placeholder="https://..." />
                    <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="SortOrder" class="form-label zb-form-label"></label>
                    <input asp-for="SortOrder" class="form-control zb-form-input" />
                    <span asp-validation-for="SortOrder" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CurrentPrice" class="form-label zb-form-label"></label>
                    <input asp-for="CurrentPrice" class="form-control zb-form-input" />
                    <span asp-validation-for="CurrentPrice" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CostPrice" class="form-label zb-form-label"></label>
                    <input asp-for="CostPrice" class="form-control zb-form-input" />
                    <span asp-validation-for="CostPrice" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="StockAvailable" class="form-label zb-form-label"></label>
                    <input asp-for="StockAvailable" class="form-control zb-form-input" />
                    <span asp-validation-for="StockAvailable" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LowStockThreshold" class="form-label zb-form-label"></label>
                    <input asp-for="LowStockThreshold" class="form-control zb-form-input" />
                    <span asp-validation-for="LowStockThreshold" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <div class="form-check mt-4">
                        <input class="form-check-input" asp-for="IsActive" style="background-color:var(--zb-primary-mid);border-color:var(--zb-text-muted);" />
                        <label class="form-check-label zb-form-label" asp-for="IsActive">@Html.DisplayNameFor(model => model.IsActive)</label>
                    </div>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn fw-semibold" style="background:var(--zb-secondary);color:#0f172a;border:none;"><i class="bi bi-check-lg me-1"></i>Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
