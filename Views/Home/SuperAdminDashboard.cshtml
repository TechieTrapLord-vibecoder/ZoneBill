@model ZoneBill_Lloren.Models.SuperAdminDashboardViewModel
@using ZoneBill_Lloren.Helpers

@{
    ViewData["Title"] = "SaaS Dashboard";
    var nowPh = PhilippineTime.Now;
}


<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0" style="color:var(--zb-text);"><i class="bi bi-globe me-2" style="color:var(--zb-secondary);"></i>SaaS Dashboard</h4>
        <p class="text-muted small mb-0">Portfolio health across all onboarded businesses.</p>
    </div>
</div>

<div class="row row-cols-2 row-cols-md-5 g-3 mb-4">
    <div class="col"><div class="zb-kpi-card" style="border-color:rgba(6,182,212,0.4);"><div class="zb-kpi-label">Total Businesses</div><div class="zb-kpi-value" style="color:var(--zb-secondary);">@Model.TotalBusinesses</div></div></div>
    <div class="col"><div class="zb-kpi-card" style="border-color:rgba(34,197,94,0.4);"><div class="zb-kpi-label">Active Businesses</div><div class="zb-kpi-value" style="color:#22c55e;">@Model.ActiveBusinesses</div></div></div>
    <div class="col"><div class="zb-kpi-card" style="border-color:rgba(6,182,212,0.4);"><div class="zb-kpi-label">Total Users</div><div class="zb-kpi-value" style="color:var(--zb-secondary);">@Model.TotalUsers</div></div></div>
    <div class="col"><div class="zb-kpi-card" style="border-color:rgba(239,68,68,0.4);"><div class="zb-kpi-label">Needs Attention</div><div class="zb-kpi-value" style="color:#ef4444;">@Model.BusinessesNeedingAttention</div></div></div>
    <div class="col"><div class="zb-kpi-card" style="border-color:rgba(6,182,212,0.4);"><div class="zb-kpi-label">Current MRR</div><div class="zb-kpi-value" style="color:var(--zb-secondary);">@Model.MonthlyRecurringRevenue.ToString("C")</div></div></div>
    <div class="col"><div class="zb-kpi-card" style="border-color:rgba(34,197,94,0.4);"><div class="zb-kpi-label">Collected (Month)</div><div class="zb-kpi-value" style="color:#22c55e;">@Model.CollectedThisMonth.ToString("C")</div></div></div>
    <div class="col"><div class="zb-kpi-card" style="border-color:rgba(239,68,68,0.4);"><div class="zb-kpi-label">Failed (Month)</div><div class="zb-kpi-value" style="color:#ef4444;">@Model.FailedThisMonth.ToString("C")</div></div></div>
    <div class="col"><div class="zb-kpi-card" style="border-color:rgba(249,115,22,0.4);"><div class="zb-kpi-label">Outstanding</div><div class="zb-kpi-value" style="color:var(--zb-accent);">@Model.OutstandingReceivables.ToString("C")</div></div></div>
    <div class="col"><div class="zb-kpi-card" style="border-color:rgba(34,197,94,0.4);"><div class="zb-kpi-label">Active Subscriptions</div><div class="zb-kpi-value" style="color:#22c55e;">@Model.ActiveSubscriptions</div></div></div>
    <div class="col"><div class="zb-kpi-card" style="border-color:rgba(239,68,68,0.4);"><div class="zb-kpi-label">Past Due / Expired</div><div class="zb-kpi-value" style="color:#ef4444;">@Model.PastDueSubscriptions</div></div></div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="zb-kpi-card position-relative overflow-hidden" style="border-color:rgba(34,197,94,0.35); padding-bottom: 0;">
            <div class="d-flex justify-content-between align-items-start position-relative z-1">
                <div>
                    <div class="zb-kpi-label mb-1">New Businesses Trend</div>
                    <div class="fs-4 fw-bold" style="color:#22c55e;">@Model.NewBusinesses30Days</div>
                    <div class="small" style="color:var(--zb-text-muted);">Last 30 days</div>
                </div>
                <div class="text-end">
                    <div class="fw-bold" style="color:var(--zb-text);font-size:1.1rem;">@Model.NewBusinesses90Days</div>
                    <div class="small" style="color:var(--zb-text-muted);">Last 90 days</div>
                </div>
            </div>
            <div style="height:90px; margin-top:-10px; margin-left:-20px; margin-right:-20px; margin-bottom:-20px;">
                <canvas id="signupTrendChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="zb-kpi-card position-relative overflow-hidden" style="border-color:rgba(249,115,22,0.35); padding-bottom: 0;">
            <div class="d-flex justify-content-between align-items-start position-relative z-1">
                <div>
                    <div class="zb-kpi-label mb-1">Churn Trend</div>
                    <div class="fs-4 fw-bold" style="color:var(--zb-accent);">@Model.ChurnedBusinesses30Days</div>
                    <div class="small" style="color:var(--zb-text-muted);">Last 30 days</div>
                </div>
                <div class="text-end">
                    <div class="fw-bold" style="color:var(--zb-text);font-size:1.1rem;">@Model.ChurnedBusinesses90Days</div>
                    <div class="small" style="color:var(--zb-text-muted);">Last 90 days</div>
                </div>
            </div>
            <div style="height:90px; margin-top:-10px; margin-left:-20px; margin-right:-20px; margin-bottom:-20px;">
                <canvas id="churnTrendChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="zb-kpi-card position-relative overflow-hidden" style="border-color:rgba(239,68,68,0.35); padding-bottom: 0;">
            <div class="d-flex justify-content-between align-items-start position-relative z-1">
                <div>
                    <div class="zb-kpi-label mb-1">Failed Renewals</div>
                    <div class="fs-4 fw-bold" style="color:#ef4444;">@Model.FailedRenewals30Days</div>
                    <div class="small" style="color:var(--zb-text-muted);">Last 30 days</div>
                </div>
                <div class="text-end">
                    <div class="fw-bold" style="color:var(--zb-text);font-size:1.1rem;">@Model.FailedRenewals90Days</div>
                    <div class="small" style="color:var(--zb-text-muted);">Last 90 days</div>
                </div>
            </div>
            <div style="height:90px; margin-top:-10px; margin-left:-20px; margin-right:-20px; margin-bottom:-20px;">
                <canvas id="failedTrendChart"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-12">
        <div class="zb-table-card">
            <div class="px-4 pt-3 pb-2 border-bottom d-flex align-items-center justify-content-between" style="border-color:rgba(6,182,212,0.15)!important;">
                <h6 class="fw-bold mb-0" style="color:var(--zb-secondary);"><i class="bi bi-exclamation-diamond me-2"></i>Businesses Needing Attention</h6>
                <div class="d-flex align-items-center gap-2">
                    <span class="zb-badge" style="background:rgba(239,68,68,0.12);color:#ef4444;border:1px solid rgba(239,68,68,0.3);">@Model.BusinessesNeedingAttention flagged</span>
                    <a asp-controller="Home" asp-action="AllAttentionBusinesses" class="btn btn-sm fw-semibold"
                       style="background:rgba(239,68,68,0.1);color:#ef4444;border:1px solid rgba(239,68,68,0.3);font-size:.78rem;">
                        <i class="bi bi-list-ul me-1"></i>View All
                    </a>
                </div>
            </div>
            @if (!Model.AttentionBusinesses.Any())
            {
                <div class="p-4 text-center" style="color:var(--zb-text-muted);">No critical tenant issues right now.</div>
            }
            else
            {
                <div class="px-4 pt-3 pb-2 border-bottom d-flex align-items-center gap-2" style="border-color:rgba(6,182,212,0.12)!important;">
                    <button type="button" class="sa-attn-filter zb-badge" data-filter="all" style="cursor:pointer;padding:4px 12px;border-radius:20px;border:1px solid rgba(6,182,212,0.35);background:rgba(6,182,212,0.15);color:var(--zb-secondary);">All</button>
                    <button type="button" class="sa-attn-filter zb-badge" data-filter="expired" style="cursor:pointer;padding:4px 12px;border-radius:20px;border:1px solid rgba(239,68,68,0.35);background:transparent;color:var(--zb-text-muted);">Expired</button>
                    <button type="button" class="sa-attn-filter zb-badge" data-filter="failed" style="cursor:pointer;padding:4px 12px;border-radius:20px;border:1px solid rgba(239,68,68,0.35);background:transparent;color:var(--zb-text-muted);">Failed</button>
                    <button type="button" class="sa-attn-filter zb-badge" data-filter="pending" style="cursor:pointer;padding:4px 12px;border-radius:20px;border:1px solid rgba(249,115,22,0.35);background:transparent;color:var(--zb-text-muted);">Pending</button>
                </div>
                <div class="table-responsive">
                    <table class="table zb-table mb-0">
                        <thead>
                            <tr>
                                <th>Business</th>
                                <th>Plan</th>
                                <th>Subscription</th>
                                <th>Period End (PH)</th>
                                <th>Latest Invoice</th>
                                <th>Why Flagged</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="saAttentionBody">
                        @foreach (var item in Model.AttentionBusinesses)
                        {
                            var isExpired = !item.CurrentPeriodEnd.HasValue || PhilippineTime.ToDateTime(item.CurrentPeriodEnd.Value) <= nowPh;
                            var invoiceStatus = (item.LatestInvoiceStatus ?? string.Empty).ToLowerInvariant();
                            var subBadge = item.SubscriptionStatus == "Active" ? "zb-badge-green" : "zb-badge-red";
                            var invBadge = item.LatestInvoiceStatus switch
                            {
                                "Paid" => "zb-badge-green",
                                "Pending" => "zb-badge-cyan",
                                "Overdue" => "zb-badge-orange",
                                "Failed" => "zb-badge-red",
                                "Cancelled" => "zb-badge-yellow",
                                _ => "zb-badge-cyan"
                            };
                            <tr data-expired="@isExpired.ToString().ToLowerInvariant()" data-invoice-status="@invoiceStatus">
                                <td class="fw-semibold" style="color:var(--zb-text);">@item.BusinessName</td>
                                <td>@item.PlanName</td>
                                <td><span class="zb-badge @subBadge">@item.SubscriptionStatus</span></td>
                                <td>
                                    @if (item.CurrentPeriodEnd.HasValue)
                                    {
                                        <span class="zb-mono">@PhilippineTime.ToDateTime(item.CurrentPeriodEnd.Value).ToString("MMM d, yyyy")</span>
                                    }
                                    else
                                    {
                                        <span style="color:var(--zb-text-muted);">—</span>
                                    }
                                </td>
                                <td>
                                    <span class="zb-badge @invBadge">@item.LatestInvoiceStatus</span>
                                    @if (item.LatestInvoiceAmount > 0)
                                    {
                                        <span class="zb-mono ms-1">@item.LatestInvoiceAmount.ToString("C")</span>
                                    }
                                </td>
                                <td style="font-size:.82rem;color:var(--zb-text-muted);">@item.AttentionReason</td>
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        <a asp-controller="Businesses" asp-action="Details" asp-route-id="@item.BusinessId" class="btn btn-sm fw-semibold w-100" style="background:rgba(6,182,212,0.12);color:var(--zb-secondary);border:1px solid rgba(6,182,212,0.3); font-size:.78rem;">
                                            <i class="bi bi-search me-1"></i>View
                                        </a>
                                        @if(isExpired || invoiceStatus == "failed" || invoiceStatus == "overdue") {
                                            <button type="button" class="btn btn-sm fw-semibold w-100" style="background:rgba(239,68,68,0.1);color:#ef4444;border:1px solid rgba(239,68,68,0.3); font-size:.78rem;" onclick="alert('Action taken for @item.BusinessName!')">
                                                <i class="bi bi-envelope me-1"></i>Remind
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-6">
        <div class="zb-table-card h-100">
            <div class="px-4 pt-3 pb-2 border-bottom" style="border-color:rgba(6,182,212,0.15)!important;">
                <h6 class="fw-bold mb-0" style="color:var(--zb-secondary);"><i class="bi bi-bar-chart me-2"></i>Businesses By Plan</h6>
            </div>
            <div class="p-4">
                <canvas id="planChart" height="170"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="zb-table-card h-100">
            <div class="px-4 pt-3 pb-2 border-bottom" style="border-color:rgba(6,182,212,0.15)!important;">
                <h6 class="fw-bold mb-0" style="color:var(--zb-secondary);"><i class="bi bi-clock-history me-2"></i>Recent Signups</h6>
            </div>
            <div class="table-responsive">
                <table class="table zb-table mb-0">
                    <thead>
                        <tr>
                            <th>Business</th>
                            <th>Plan</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var signup in Model.RecentSignups)
                    {
                        <tr>
                            <td class="fw-semibold" style="color:var(--zb-text);">@signup.BusinessName</td>
                            <td>@signup.PlanName</td>
                            <td><span class="zb-mono">@PhilippineTime.ToDateTime(signup.CreatedAt).ToString("MMM d, yyyy")</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Sparkline layout merged into trend cards above -->

    <div class="col-12">
        <div class="zb-table-card">
            <div class="px-4 pt-3 pb-2 border-bottom" style="border-color:rgba(6,182,212,0.15)!important;">
                <div class="d-flex align-items-center justify-content-between">
                    <h6 class="fw-bold mb-0" style="color:var(--zb-secondary);"><i class="bi bi-journal-text me-2"></i>Recent Admin Actions</h6>
                    <a asp-controller="Home" asp-action="SuperAdminAuditLog" class="btn btn-sm"
                       style="background:rgba(6,182,212,0.1);color:var(--zb-secondary);border:1px solid rgba(6,182,212,0.25);font-size:.78rem;">
                        <i class="bi bi-list-ul me-1"></i>Full Log
                    </a>
                </div>
            </div>
            @if (!Model.RecentAuditLogs.Any())
            {
                <div class="p-4 text-center" style="color:var(--zb-text-muted);">No audit actions recorded yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table zb-table mb-0">
                        <thead>
                            <tr>
                                <th>When (PH)</th>
                                <th>Action</th>
                                <th>Entity</th>
                                <th>Details</th>
                                <th>By</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var log in Model.RecentAuditLogs)
                        {
                            <tr>
                                <td><span class="zb-mono">@PhilippineTime.ToDateTime(log.CreatedAt).ToString("MMM d, h:mm tt")</span></td>
                                <td><span class="zb-badge zb-badge-cyan">@log.ActionType</span></td>
                                <td>@log.EntityType</td>
                                <td style="font-size:.82rem;color:var(--zb-text-muted);">
                                    @log.Details
                                    @if (!string.IsNullOrWhiteSpace(log.Reason))
                                    {
                                        <span> | Reason: @log.Reason</span>
                                    }
                                </td>
                                <td>@log.ActorName</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        Chart.defaults.color = '#94a3b8';
        Chart.defaults.borderColor = 'rgba(51,65,85,0.5)';

        const planLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PlanLabels));
        const planCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PlanBusinessCounts));
        const trendLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TrendLabels));
        const signupTrend = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.NewBusinessTrend));
        const churnTrend = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChurnTrend));
        const failedTrend = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FailedRenewalTrend));

        new Chart(document.getElementById('planChart'), {
            type: 'doughnut',
            data: {
                labels: planLabels,
                datasets: [{
                    data: planCounts,
                    backgroundColor: ['#06b6d4', '#22c55e', '#f97316', '#ef4444', '#a855f7'],
                    borderWidth: 0,
                    hoverOffset: 6
                }]
            },
            options: {
                cutout: '75%',
                plugins: {
                    legend: { position: 'right', labels: { color: '#94a3b8', usePointStyle: true, padding: 20, font: { size: 13 } } }
                },
                layout: { padding: 10 }
            }
        });

        function renderSparkline(id, data, colorStr, bgGradientStart, bgGradientEnd) {
            const ctx = document.getElementById(id).getContext('2d');
            const gradient = ctx.createLinearGradient(0, 0, 0, 90);
            gradient.addColorStop(0, bgGradientStart);
            gradient.addColorStop(1, bgGradientEnd);

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: trendLabels,
                    datasets: [{
                        data: data,
                        borderColor: colorStr,
                        backgroundColor: gradient,
                        fill: true,
                        borderWidth: 2,
                        tension: 0.4,
                        pointRadius: 0,
                        pointHoverRadius: 4,
                        hoverBackgroundColor: colorStr
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false }, tooltip: { enabled: true, mode: 'index', intersect: false } },
                    scales: {
                        x: { display: false },
                        y: { display: false, beginAtZero: true, min: 0 }
                    },
                    layout: { padding: { top: 5, bottom: 0, left: 0, right: 0 } }
                }
            });
        }

        renderSparkline('signupTrendChart', signupTrend, '#22c55e', 'rgba(34,197,94,0.3)', 'rgba(34,197,94,0.0)');
        renderSparkline('churnTrendChart', churnTrend, '#f97316', 'rgba(249,115,22,0.3)', 'rgba(249,115,22,0.0)');
        renderSparkline('failedTrendChart', failedTrend, '#ef4444', 'rgba(239,68,68,0.3)', 'rgba(239,68,68,0.0)');

        (function () {
            const chips = document.querySelectorAll('.sa-attn-filter');
            const rows = document.querySelectorAll('#saAttentionBody tr');
            if (!chips.length || !rows.length) return;

            const activeStyle = 'cursor:pointer;padding:4px 12px;border-radius:20px;border:1px solid rgba(6,182,212,0.35);background:rgba(6,182,212,0.15);color:var(--zb-secondary);';
            const resetStyle = {
                all: 'cursor:pointer;padding:4px 12px;border-radius:20px;border:1px solid rgba(6,182,212,0.35);background:transparent;color:var(--zb-text-muted);',
                expired: 'cursor:pointer;padding:4px 12px;border-radius:20px;border:1px solid rgba(239,68,68,0.35);background:transparent;color:var(--zb-text-muted);',
                failed: 'cursor:pointer;padding:4px 12px;border-radius:20px;border:1px solid rgba(239,68,68,0.35);background:transparent;color:var(--zb-text-muted);',
                pending: 'cursor:pointer;padding:4px 12px;border-radius:20px;border:1px solid rgba(249,115,22,0.35);background:transparent;color:var(--zb-text-muted);'
            };

            function applyFilter(filter) {
                rows.forEach(function (row) {
                    const expired = row.getAttribute('data-expired') === 'true';
                    const inv = row.getAttribute('data-invoice-status');
                    let show = true;

                    if (filter === 'expired') show = expired;
                    if (filter === 'failed') show = inv === 'failed' || inv === 'overdue';
                    if (filter === 'pending') show = inv === 'pending';

                    row.style.display = show ? '' : 'none';
                });

                chips.forEach(function (chip) {
                    const f = chip.getAttribute('data-filter');
                    chip.style.cssText = f === filter ? activeStyle : (resetStyle[f] || resetStyle.all);
                });
            }

            chips.forEach(function (chip) {
                chip.addEventListener('click', function () {
                    applyFilter(chip.getAttribute('data-filter') || 'all');
                });
            });
        })();
    </script>
}
