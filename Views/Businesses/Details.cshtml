@model ZoneBill_Lloren.Models.Business
@using ZoneBill_Lloren.Models
@using ZoneBill_Lloren.Helpers

@{
    ViewData["Title"] = "Business Details";
    var lifecycle = ViewBag.LifecycleEvents as List<BusinessLifecycleEvent> ?? new List<BusinessLifecycleEvent>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0" style="color:var(--zb-text);">
        <i class="bi bi-info-circle me-2" style="color:var(--zb-secondary);"></i>Business Details
    </h4>
    <div>
        @if (User.IsInRole("SuperAdmin"))
        {
            <form asp-action="SetLifecycleState" method="post" class="d-inline" onsubmit="return zbBusinessLifecyclePrompt(this, '@Model.BusinessName', @(Model.IsActive.ToString().ToLowerInvariant()));">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.BusinessId" />
                <input type="hidden" name="isActive" value="@(!Model.IsActive)" />
                <input type="hidden" name="reason" value="" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <button type="submit" class="btn btn-sm fw-semibold me-2" style="@(@Model.IsActive ? "background:rgba(249,115,22,0.15);color:var(--zb-accent);border:1px solid rgba(249,115,22,0.3);" : "background:rgba(34,197,94,0.12);color:#22c55e;border:1px solid rgba(34,197,94,0.3);")">
                    <i class="bi @(@Model.IsActive ? "bi-pause-circle" : "bi-play-circle") me-1"></i>@(@Model.IsActive ? "Suspend" : "Reactivate")
                </button>
            </form>
        }
        <a asp-action="Edit" asp-route-id="@Model?.BusinessId" class="btn btn-sm fw-semibold me-2" style="background:rgba(249,115,22,0.15);color:var(--zb-accent);border:1px solid rgba(249,115,22,0.3);">
            <i class="bi bi-pencil-square me-1"></i>Edit
        </a>
        <a asp-action="Index" class="btn btn-sm fw-semibold" style="background:rgba(6,182,212,0.12);color:var(--zb-secondary);border:1px solid rgba(6,182,212,0.3);">
            <i class="bi bi-arrow-left me-1"></i>Back to List
        </a>
    </div>
</div>

<div class="zb-table-card">
    <div class="p-4">
        <dl class="row mb-0">
            <dt class="col-sm-3 zb-form-label py-2">@Html.DisplayNameFor(model => model.Plan)</dt>
            <dd class="col-sm-9 py-2" style="color:var(--zb-text);">@Html.DisplayFor(model => model.Plan.PlanName)</dd>
            <dt class="col-sm-3 zb-form-label py-2">@Html.DisplayNameFor(model => model.BusinessName)</dt>
            <dd class="col-sm-9 py-2" style="color:var(--zb-text);">@Html.DisplayFor(model => model.BusinessName)</dd>
            <dt class="col-sm-3 zb-form-label py-2">@Html.DisplayNameFor(model => model.DomainPrefix)</dt>
            <dd class="col-sm-9 py-2" style="color:var(--zb-text);">@Html.DisplayFor(model => model.DomainPrefix)</dd>
            <dt class="col-sm-3 zb-form-label py-2">@Html.DisplayNameFor(model => model.LogoUrl)</dt>
            <dd class="col-sm-9 py-2" style="color:var(--zb-text);">
                @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
                {
                    <a href="@Model.LogoUrl" target="_blank" rel="noopener noreferrer" style="color:var(--zb-secondary);">@Model.LogoUrl</a>
                }
                else
                {
                    <span style="color:var(--zb-text-muted);">-</span>
                }
            </dd>
            <dt class="col-sm-3 zb-form-label py-2">@Html.DisplayNameFor(model => model.TaxRatePercentage)</dt>
            <dd class="col-sm-9 py-2" style="color:var(--zb-text);">@Model.TaxRatePercentage.ToString("0.##")%</dd>
            <dt class="col-sm-3 zb-form-label py-2">@Html.DisplayNameFor(model => model.CreatedAt)</dt>
            <dd class="col-sm-9 py-2" style="color:var(--zb-text);">@Html.DisplayFor(model => model.CreatedAt)</dd>
            <dt class="col-sm-3 zb-form-label py-2">@Html.DisplayNameFor(model => model.IsActive)</dt>
            <dd class="col-sm-9 py-2" style="color:var(--zb-text);">@Html.DisplayFor(model => model.IsActive)</dd>
        </dl>
    </div>
</div>

<div class="zb-table-card mt-4">
    <div class="px-4 pt-3 pb-2 border-bottom" style="border-color:rgba(6,182,212,0.15)!important;">
        <h6 class="fw-bold mb-0" style="color:var(--zb-secondary);"><i class="bi bi-clock-history me-2"></i>Lifecycle Timeline</h6>
    </div>
    @if (!lifecycle.Any())
    {
        <div class="p-4 text-center" style="color:var(--zb-text-muted);">No lifecycle events yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table zb-table mb-0">
                <thead>
                    <tr>
                        <th>When (PH)</th>
                        <th>Event</th>
                        <th>Changed</th>
                        <th>Reason</th>
                        <th>By</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var e in lifecycle)
                {
                    <tr>
                        <td><span class="zb-mono">@PhilippineTime.ToDateTime(e.CreatedAt).ToString("MMM d, yyyy h:mm tt")</span></td>
                        <td><span class="zb-badge" style="background:rgba(6,182,212,0.12);color:var(--zb-secondary);border:1px solid rgba(6,182,212,0.3);">@e.EventType</span></td>
                        <td style="font-size:.82rem;color:var(--zb-text-muted);">@e.PreviousValue → @e.NewValue</td>
                        <td style="font-size:.82rem;color:var(--zb-text-muted);">@(string.IsNullOrWhiteSpace(e.Reason) ? "—" : e.Reason)</td>
                        <td>@(string.IsNullOrWhiteSpace(e.ActorName) ? "System" : e.ActorName)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        function zbBusinessLifecyclePrompt(form, businessName, currentlyActive) {
            const actionLabel = currentlyActive ? 'suspend' : 'reactivate';
            const reason = prompt('Reason to ' + actionLabel + ' "' + businessName + '"?', currentlyActive ? 'Billing review' : 'Issue resolved');
            if (reason === null) return false;
            form.querySelector('input[name="reason"]').value = reason.trim();
            return confirm('Confirm ' + actionLabel + ' for "' + businessName + '"?');
        }
    </script>
}
