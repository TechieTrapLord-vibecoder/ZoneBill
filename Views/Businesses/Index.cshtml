@model IEnumerable<ZoneBill_Lloren.Models.Business>
@using ZoneBill_Lloren.Helpers

@{
    ViewData["Title"] = "Businesses";
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages  = (int)(ViewBag.TotalPages  ?? 1);
    var totalCount  = (int)(ViewBag.TotalCount  ?? 0);
    var paging = new ZoneBill_Lloren.Models.PagingInfo { CurrentPage = currentPage, TotalPages = totalPages, TotalCount = totalCount, UrlTemplate = Url.Action("Index", new { page = "__PAGE__" }) ?? "#" };
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-0" style="color:var(--zb-text);"><i class="bi bi-building me-2" style="color:var(--zb-secondary);"></i>Businesses</h4>
        <p class="text-muted small mb-0">All registered tenant businesses on ZoneBill.</p>
    </div>
    <a asp-action="Create" class="btn btn-sm fw-semibold" style="background:var(--zb-accent);color:#fff;border:none;">
        <i class="bi bi-plus-lg me-1"></i> Add Business
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="zb-kpi-card" style="border-color:rgba(6,182,212,0.4);">
            <div class="zb-kpi-label">Total Businesses</div>
            <div class="zb-kpi-value" style="color:var(--zb-secondary);">@totalCount</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="zb-kpi-card" style="border-color:rgba(34,197,94,0.4);">
            <div class="zb-kpi-label">Active</div>
            <div class="zb-kpi-value" style="color:#22c55e;">@(ViewBag.ActiveCount ?? 0)</div>
        </div>
    </div>
</div>

<div class="zb-table-card">
    <div class="table-responsive">
        <table class="table zb-table mb-0">
            <thead>
                <tr>
                    <th>Business Name</th>
                    <th>Plan</th>
                    <th>Domain Prefix</th>
                    <th>Joined</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold" style="color:var(--zb-text);">@item.BusinessName</td>
                        <td>@(item.Plan?.PlanName ?? "—")</td>
                        <td><span class="zb-mono">@item.DomainPrefix</span></td>
                        <td><span class="zb-mono">@PhilippineTime.ToDateTime(item.CreatedAt).ToString("MMM d, yyyy")</span></td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="zb-badge zb-badge-green">Active</span>
                            }
                            else
                            {
                                <span class="zb-badge zb-badge-red">Inactive</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Details" asp-route-id="@item.BusinessId" class="zb-action-btn" title="View"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@item.BusinessId" class="zb-action-btn" title="Edit"><i class="bi bi-pencil"></i></a>
                                @if (User.IsInRole("SuperAdmin"))
                                {
                                    <form asp-action="SetLifecycleState" method="post" class="d-inline" onsubmit="return zbBusinessLifecyclePrompt(this, '@item.BusinessName', @(item.IsActive.ToString().ToLowerInvariant()));">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.BusinessId" />
                                        <input type="hidden" name="isActive" value="@(!item.IsActive)" />
                                        <input type="hidden" name="reason" value="" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit" class="zb-action-btn @(item.IsActive ? "zb-action-archive" : "zb-action-restore")" title="@(item.IsActive ? "Suspend" : "Reactivate")">
                                            <i class="bi @(item.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                        </button>
                                    </form>
                                }

                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination", paging)
</div>
    <script>
        function zbBusinessLifecyclePrompt(form, businessName, currentlyActive) {
            const actionLabel = currentlyActive ? 'suspend' : 'reactivate';
            const reason = prompt('Reason to ' + actionLabel + ' "' + businessName + '"?', currentlyActive ? 'Billing review' : 'Issue resolved');
            if (reason === null) return false;
            form.querySelector('input[name="reason"]').value = reason.trim();
            return confirm('Confirm ' + actionLabel + ' for "' + businessName + '"?');
        }
    </script>
}
