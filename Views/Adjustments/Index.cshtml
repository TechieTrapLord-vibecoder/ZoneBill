@model IEnumerable<ZoneBill_Lloren.Models.Adjustment>

@{
    ViewData["Title"] = "Adjustments";
    var search = ViewBag.Search as string;
    var adjustmentType = ViewBag.AdjustmentType as string;
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    string PageUrl(int nextPage) => Url.Action("Index", new { search, adjustmentType, page = nextPage }) ?? "#";
    var paging = new ZoneBill_Lloren.Models.PagingInfo { CurrentPage = currentPage, TotalPages = totalPages, TotalCount = totalCount, UrlTemplate = PageUrl(0).Replace("page=0", "page=__PAGE__") };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0" style="color:var(--zb-text);"><i class="bi bi-sliders me-2" style="color:var(--zb-secondary);"></i>Adjustments</h4>
    <a asp-action="Create" class="btn btn-sm fw-semibold" style="background:var(--zb-secondary);color:#0f172a;border:none;"><i class="bi bi-plus-lg me-1"></i>Create New</a>
</div>

<form method="get" class="zb-table-card p-3 mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-6">
            <label class="form-label small" style="color:var(--zb-text-muted);">Search</label>
            <input type="text" name="search" value="@search" class="form-control zb-form-input" placeholder="Invoice ID, reason, invoice status" />
        </div>
        <div class="col-md-3">
            <label class="form-label small" style="color:var(--zb-text-muted);">Adjustment Type</label>
            <select name="adjustmentType" class="form-select zb-form-input">
                <option value="">All types</option>
                <option value="Debit" selected="@(adjustmentType == "Debit" ? "selected" : null)">Debit</option>
                <option value="Credit" selected="@(adjustmentType == "Credit" ? "selected" : null)">Credit</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-sm fw-semibold flex-grow-1" style="background:rgba(6,182,212,0.15);color:var(--zb-secondary);border:1px solid rgba(6,182,212,0.3);">Apply</button>
            <a href="@Url.Action("Index")" class="btn btn-sm" style="background:rgba(255,255,255,0.06);color:var(--zb-text-muted);border:1px solid rgba(255,255,255,0.1);">Reset</a>
        </div>
    </div>
</form>

<div class="zb-table-card">
    <div class="table-responsive">
        <table class="table zb-table align-middle mb-0">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Invoice)</th>
                    <th>@Html.DisplayNameFor(model => model.AdjustmentType)</th>
                    <th>@Html.DisplayNameFor(model => model.Amount)</th>
                    <th>@Html.DisplayNameFor(model => model.Reason)</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Invoice.PaymentStatus)</td>
                        <td>@Html.DisplayFor(modelItem => item.AdjustmentType)</td>
                        <td>@Html.DisplayFor(modelItem => item.Amount)</td>
                        <td>@Html.DisplayFor(modelItem => item.Reason)</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.AdjustmentId" class="zb-action-btn" title="Edit"><i class="bi bi-pencil-square"></i></a>
                            <a asp-action="Details" asp-route-id="@item.AdjustmentId" class="zb-action-btn" title="Details"><i class="bi bi-eye"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination", paging)
</div>
