@model IEnumerable<ZoneBill_Lloren.Models.TenantAuditLog>
@{
    ViewData["Title"] = "Activity Log";
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var paging = new ZoneBill_Lloren.Models.PagingInfo
    {
        CurrentPage = currentPage,
        TotalPages = totalPages,
        TotalCount = totalCount,
        UrlTemplate = Url.Action("TenantAuditLog", new {
            startDate = ViewBag.StartDate,
            endDate = ViewBag.EndDate,
            actionType = ViewBag.ActionType,
            staffName = ViewBag.StaffName,
            page = "__PAGE__"
        }) ?? "#"
    };
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-0" style="color:var(--zb-text);"><i class="bi bi-shield-check me-2" style="color:var(--zb-secondary);"></i>Activity Log</h4>
        <p class="text-muted small mb-0">Full audit trail of actions performed by your staff.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="ExportAuditExcel"
           asp-route-startDate="@ViewBag.StartDate"
           asp-route-endDate="@ViewBag.EndDate"
           asp-route-actionType="@ViewBag.ActionType"
           asp-route-staffName="@ViewBag.StaffName"
           class="btn btn-sm fw-semibold" style="background:rgba(34,197,94,0.15);color:#22c55e;border:1px solid rgba(34,197,94,0.3);">
            <i class="bi bi-file-earmark-excel me-1"></i>Export Excel
        </a>
        <a asp-action="ExportAuditPdf"
           asp-route-startDate="@ViewBag.StartDate"
           asp-route-endDate="@ViewBag.EndDate"
           asp-route-actionType="@ViewBag.ActionType"
           asp-route-staffName="@ViewBag.StaffName"
           class="btn btn-sm fw-semibold" style="background:rgba(239,68,68,0.15);color:#ef4444;border:1px solid rgba(239,68,68,0.3);">
            <i class="bi bi-filetype-pdf me-1"></i>Export PDF
        </a>
    </div>
</div>

<!-- Filters -->
<div class="zb-table-card mb-4" style="padding:18px 20px;">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label mb-1" style="color:var(--zb-text);font-size:0.82rem;font-weight:500;">Start Date</label>
            <input type="date" name="startDate" class="form-control form-control-sm"
                   style="background:var(--zb-primary-mid);border:1px solid rgba(6,182,212,0.25);color:var(--zb-text);"
                   value="@ViewBag.StartDate" />
        </div>
        <div class="col-md-3">
            <label class="form-label mb-1" style="color:var(--zb-text);font-size:0.82rem;font-weight:500;">End Date</label>
            <input type="date" name="endDate" class="form-control form-control-sm"
                   style="background:var(--zb-primary-mid);border:1px solid rgba(6,182,212,0.25);color:var(--zb-text);"
                   value="@ViewBag.EndDate" />
        </div>
        <div class="col-md-2">
            <label class="form-label mb-1" style="color:var(--zb-text);font-size:0.82rem;font-weight:500;">Action Type</label>
            <select name="actionType" class="form-select form-select-sm"
                    style="background:var(--zb-primary-mid);border:1px solid rgba(6,182,212,0.25);color:var(--zb-text);">
                <option value="">All Actions</option>
                @if (ViewBag.ActionTypes != null)
                {
                    var selectedAction = ViewBag.ActionType as string;
                    foreach (var act in ViewBag.ActionTypes as List<string>)
                    {
                        if (act == selectedAction)
                        {
                            <option value="@act" selected="selected">@act</option>
                        }
                        else
                        {
                            <option value="@act">@act</option>
                        }
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label mb-1" style="color:var(--zb-text);font-size:0.82rem;font-weight:500;">Staff Name</label>
            <input type="text" name="staffName" class="form-control form-control-sm"
                   style="background:var(--zb-primary-mid);border:1px solid rgba(6,182,212,0.25);color:var(--zb-text);"
                   value="@ViewBag.StaffName" placeholder="Search name..." />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-sm fw-semibold w-100"
                    style="background:var(--zb-accent);color:#fff;border:none;">
                <i class="bi bi-funnel me-1"></i>Filter
            </button>
        </div>
    </form>
</div>

<!-- Table -->
<div class="zb-table-card">
    <div class="table-responsive">
        <table class="table zb-table mb-0">
            <thead>
                <tr>
                    <th style="width:145px;">Date / Time</th>
                    <th>Staff Member</th>
                    <th>Role</th>
                    <th>Action</th>
                    <th>Category</th>
                    <th>What Happened</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            No activity found for the selected filters.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var log in Model)
                    {
                        string roleBadge;
                        if (log.UserRole == "MainAdmin") roleBadge = "zb-badge-cyan";
                        else if (log.UserRole == "Manager") roleBadge = "zb-badge-orange";
                        else if (log.UserRole == "Cashier") roleBadge = "zb-badge-green";
                        else roleBadge = "zb-badge-cyan";

                        string actionBadge;
                        if (log.ActionType == "Logged In" || log.ActionType == "Created" || log.ActionType == "Restored" || log.ActionType == "Opened" || log.ActionType == "Reopened" || log.ActionType == "Restocked") actionBadge = "zb-badge-green";
                        else if (log.ActionType == "Updated" || log.ActionType == "Processed" || log.ActionType == "Closed") actionBadge = "zb-badge-cyan";
                        else if (log.ActionType == "Archived" || log.ActionType == "Force Closed" || log.ActionType == "Discount Applied" || log.ActionType == "Spoilage") actionBadge = "zb-badge-orange";
                        else if (log.ActionType == "Account Locked" || log.ActionType == "Voided" || log.ActionType == "Deleted") actionBadge = "zb-badge-red";
                        else actionBadge = "zb-badge-cyan";

                        string categoryLabel;
                        if (log.EntityType == "Login" || log.EntityType == "Security") categoryLabel = "Security";
                        else if (log.EntityType == "User") categoryLabel = "Staff Management";
                        else if (log.EntityType == "MenuItem") categoryLabel = "Menu / Inventory";
                        else if (log.EntityType == "Payment") categoryLabel = "Payment";
                        else if (log.EntityType == "Order") categoryLabel = "Order";
                        else if (log.EntityType == "Space") categoryLabel = "Venue / Space";
                        else if (log.EntityType == "Shift") categoryLabel = "Shift / Drawer";
                        else categoryLabel = log.EntityType ?? "General";

                        <tr>
                            <td class="text-nowrap">
                                <small style="color:var(--zb-text);">@log.CreatedAt.ToString("MMM dd, yyyy")</small><br />
                                <small class="text-muted">@log.CreatedAt.ToString("HH:mm")</small>
                            </td>
                            <td>
                                <span class="fw-semibold" style="color:var(--zb-text);">@log.UserName</span>
                            </td>
                            <td>
                                <span class="zb-badge @roleBadge">@log.UserRole</span>
                            </td>
                            <td>
                                <span class="zb-badge @actionBadge">@log.ActionType</span>
                            </td>
                            <td>
                                <small style="color:var(--zb-text);">@categoryLabel</small>
                            </td>
                            <td>
                                <small class="text-muted">@log.Details</small>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pagination", paging)
</div>
