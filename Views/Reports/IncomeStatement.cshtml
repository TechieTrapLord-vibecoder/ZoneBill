@model ZoneBill_Lloren.Models.IncomeStatementViewModel

@{
    ViewData["Title"] = "Income Statement";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h4 class="fw-bold mb-0" style="color:var(--zb-text);"><i class="bi bi-graph-up-arrow me-2" style="color:var(--zb-secondary);"></i>Income Statement (P&amp;L)</h4>
        <p class="text-muted small mb-0">Profit &amp; Loss as of @Model.AsOfDate.ToString("MMMM dd, yyyy") — all-time</p>
    </div>
    <a asp-action="Index" class="btn btn-sm fw-semibold" style="background:rgba(6,182,212,0.1);color:var(--zb-secondary);border:1px solid rgba(6,182,212,0.3);">
        <i class="bi bi-arrow-left me-1"></i>Back to Reports
    </a>
</div>

@if (!Model.RevenueLines.Any() && !Model.ExpenseLines.Any())
{
    <div class="zb-table-card p-4 text-center">
        <i class="bi bi-journal-x fs-2 mb-2 d-block" style="color:var(--zb-text-muted);"></i>
        <p class="text-muted mb-0">No journal entries recorded yet. The income statement will populate once payments are processed.</p>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-7">

            @* REVENUE *@
            <div class="zb-table-card mb-4">
                <div class="px-4 pt-3 pb-2 border-bottom" style="border-color:rgba(6,182,212,0.15)!important;">
                    <h6 class="fw-bold mb-0" style="color:#22c55e;"><i class="bi bi-arrow-up-circle me-2"></i>Revenue</h6>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0" style="color:var(--zb-text);">
                        <tbody>
                            @if (Model.RevenueLines.Any())
                            {
                                @foreach (var line in Model.RevenueLines)
                                {
                                    <tr style="border-bottom:1px solid rgba(255,255,255,0.04);">
                                        <td class="ps-4 py-3">@line.AccountName</td>
                                        <td class="pe-4 py-3 text-end font-monospace" style="color:#22c55e;">₱@line.Amount.ToString("N2")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="2" class="ps-4 py-3 text-muted">No revenue recorded.</td></tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr style="border-top:2px solid rgba(34,197,94,0.35); background:rgba(34,197,94,0.05);">
                                <td class="ps-4 py-3 fw-bold" style="color:#22c55e;">Total Revenue</td>
                                <td class="pe-4 py-3 text-end fw-bold font-monospace" style="color:#22c55e;">₱@Model.TotalRevenue.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            @* EXPENSES *@
            <div class="zb-table-card mb-4">
                <div class="px-4 pt-3 pb-2 border-bottom" style="border-color:rgba(6,182,212,0.15)!important;">
                    <h6 class="fw-bold mb-0" style="color:#ef4444;"><i class="bi bi-arrow-down-circle me-2"></i>Expenses</h6>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0" style="color:var(--zb-text);">
                        <tbody>
                            @if (Model.ExpenseLines.Any())
                            {
                                @foreach (var line in Model.ExpenseLines)
                                {
                                    <tr style="border-bottom:1px solid rgba(255,255,255,0.04);">
                                        <td class="ps-4 py-3">@line.AccountName</td>
                                        <td class="pe-4 py-3 text-end font-monospace" style="color:#ef4444;">₱@line.Amount.ToString("N2")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="2" class="ps-4 py-3 text-muted">No expenses recorded.</td></tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr style="border-top:2px solid rgba(239,68,68,0.35); background:rgba(239,68,68,0.05);">
                                <td class="ps-4 py-3 fw-bold" style="color:#ef4444;">Total Expenses</td>
                                <td class="pe-4 py-3 text-end fw-bold font-monospace" style="color:#ef4444;">₱@Model.TotalExpenses.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

        </div>

        <div class="col-lg-5">
            @* NET INCOME SUMMARY *@
            <div class="zb-table-card">
                <div class="px-4 pt-3 pb-2 border-bottom" style="border-color:rgba(6,182,212,0.15)!important;">
                    <h6 class="fw-bold mb-0" style="color:var(--zb-secondary);"><i class="bi bi-clipboard-data me-2"></i>Summary</h6>
                </div>
                <div class="p-4">
                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom" style="border-color:rgba(255,255,255,0.06)!important;">
                        <span style="color:var(--zb-text-muted);">Total Revenue</span>
                        <span class="fw-semibold font-monospace" style="color:#22c55e;">₱@Model.TotalRevenue.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom" style="border-color:rgba(255,255,255,0.06)!important;">
                        <span style="color:var(--zb-text-muted);">Total Expenses</span>
                        <span class="fw-semibold font-monospace" style="color:#ef4444;">₱@Model.TotalExpenses.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-4">
                        <span class="fw-bold fs-6" style="color:var(--zb-text);">Net Income</span>
                        <span class="fw-bold fs-5 font-monospace" style="color:@(Model.NetIncome >= 0 ? "#22c55e" : "#ef4444");">
                            @(Model.NetIncome < 0 ? "-" : "")₱@Math.Abs(Model.NetIncome).ToString("N2")
                        </span>
                    </div>
                    @if (Model.TotalRevenue > 0)
                    {
                        var marginPct = Math.Round(Model.NetIncome / Model.TotalRevenue * 100m, 1);
                        <div class="mt-3 pt-3 border-top" style="border-color:rgba(255,255,255,0.06)!important;">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="small" style="color:var(--zb-text-muted);">Net Margin</span>
                                <span class="small fw-semibold" style="color:@(marginPct >= 0 ? "#22c55e" : "#ef4444");">@marginPct%</span>
                            </div>
                            <div style="height:8px; background:rgba(255,255,255,0.08); border-radius:4px; overflow:hidden;">
                                <div style="width:@Math.Min(Math.Abs(marginPct), 100m)%; height:100%; background:@(marginPct >= 0 ? "#22c55e" : "#ef4444"); border-radius:4px;"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
