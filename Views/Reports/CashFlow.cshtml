@model ZoneBill_Lloren.Models.CashFlowViewModel

@{
    ViewData["Title"] = "Cash Flow Statement";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h4 class="fw-bold mb-0" style="color:var(--zb-text);"><i class="bi bi-currency-exchange me-2" style="color:var(--zb-secondary);"></i>Cash Flow Statement</h4>
        <p class="text-muted small mb-0">Cash movements as of @Model.AsOfDate.ToString("MMMM dd, yyyy") — all-time cumulative</p>
    </div>
    <a asp-action="Index" class="btn btn-sm fw-semibold" style="background:rgba(6,182,212,0.1);color:var(--zb-secondary);border:1px solid rgba(6,182,212,0.3);">
        <i class="bi bi-arrow-left me-1"></i>Back to Reports
    </a>
</div>

<div class="row g-4">

    @* Operating Activities *@
    <div class="col-lg-7">
        <div class="zb-table-card">
            <div class="px-4 pt-3 pb-2 border-bottom" style="border-color:rgba(6,182,212,0.15)!important;">
                <h6 class="fw-bold mb-0" style="color:var(--zb-secondary);"><i class="bi bi-arrow-repeat me-2"></i>Operating Activities</h6>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0" style="color:var(--zb-text);">
                    <tbody>
                        <tr style="border-bottom:1px solid rgba(255,255,255,0.04);">
                            <td class="ps-4 py-3">Cash Collected from Customers</td>
                            <td class="pe-4 py-3 text-end font-monospace" style="color:#22c55e;">₱@Model.CashFromCustomers.ToString("N2")</td>
                        </tr>
                        <tr style="border-bottom:1px solid rgba(255,255,255,0.04);">
                            <td class="ps-4 py-3">Cost of Goods Sold (COGS)</td>
                            <td class="pe-4 py-3 text-end font-monospace" style="color:#ef4444;">–₱@Model.CostOfGoodsSold.ToString("N2")</td>
                        </tr>
                        <tr style="border-bottom:1px solid rgba(255,255,255,0.04);">
                            <td class="ps-4 py-3">
                                Net Invoice Adjustments
                                <small class="d-block" style="color:var(--zb-text-muted);font-size:0.75rem;">Debit adjustments add; Credit adjustments subtract</small>
                            </td>
                            <td class="pe-4 py-3 text-end font-monospace" style="color:@(Model.NetAdjustments >= 0 ? "#22c55e" : "#ef4444");">
                                @(Model.NetAdjustments < 0 ? "-" : "")₱@Math.Abs(Model.NetAdjustments).ToString("N2")
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr style="border-top:2px solid rgba(6,182,212,0.35); background:rgba(6,182,212,0.05);">
                            <td class="ps-4 py-3 fw-bold" style="color:var(--zb-secondary);">Net Cash from Operating Activities</td>
                            <td class="pe-4 py-3 text-end fw-bold font-monospace" style="color:@(Model.NetOperatingCash >= 0 ? "#22c55e" : "#ef4444");">
                                @(Model.NetOperatingCash < 0 ? "-" : "")₱@Math.Abs(Model.NetOperatingCash).ToString("N2")
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="zb-table-card mt-4">
            <div class="px-4 pt-3 pb-2 border-bottom" style="border-color:rgba(6,182,212,0.15)!important;">
                <h6 class="fw-bold mb-0" style="color:var(--zb-text-muted);"><i class="bi bi-building me-2"></i>Investing Activities</h6>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0" style="color:var(--zb-text);">
                    <tbody>
                        <tr>
                            <td class="ps-4 py-3 text-muted" colspan="2">No capital expenditure data tracked.</td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr style="border-top:2px solid rgba(255,255,255,0.08); background:rgba(255,255,255,0.02);">
                            <td class="ps-4 py-3 fw-bold" style="color:var(--zb-text-muted);">Net Cash from Investing Activities</td>
                            <td class="pe-4 py-3 text-end fw-bold font-monospace" style="color:var(--zb-text-muted);">₱0.00</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="zb-table-card mt-4">
            <div class="px-4 pt-3 pb-2 border-bottom" style="border-color:rgba(6,182,212,0.15)!important;">
                <h6 class="fw-bold mb-0" style="color:var(--zb-text-muted);"><i class="bi bi-bank2 me-2"></i>Financing Activities</h6>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0" style="color:var(--zb-text);">
                    <tbody>
                        <tr>
                            <td class="ps-4 py-3 text-muted" colspan="2">No financing data tracked.</td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr style="border-top:2px solid rgba(255,255,255,0.08); background:rgba(255,255,255,0.02);">
                            <td class="ps-4 py-3 fw-bold" style="color:var(--zb-text-muted);">Net Cash from Financing Activities</td>
                            <td class="pe-4 py-3 text-end fw-bold font-monospace" style="color:var(--zb-text-muted);">₱0.00</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    @* Summary Card *@
    <div class="col-lg-5">
        <div class="zb-table-card">
            <div class="px-4 pt-3 pb-2 border-bottom" style="border-color:rgba(6,182,212,0.15)!important;">
                <h6 class="fw-bold mb-0" style="color:var(--zb-secondary);"><i class="bi bi-clipboard-data me-2"></i>Summary</h6>
            </div>
            <div class="p-4">
                <div class="d-flex justify-content-between align-items-center py-3 border-bottom" style="border-color:rgba(255,255,255,0.06)!important;">
                    <span style="color:var(--zb-text-muted);">Cash Collected</span>
                    <span class="fw-semibold font-monospace" style="color:#22c55e;">₱@Model.CashFromCustomers.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-3 border-bottom" style="border-color:rgba(255,255,255,0.06)!important;">
                    <span style="color:var(--zb-text-muted);">COGS Paid</span>
                    <span class="fw-semibold font-monospace" style="color:#ef4444;">–₱@Model.CostOfGoodsSold.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-3 border-bottom" style="border-color:rgba(255,255,255,0.06)!important;">
                    <span style="color:var(--zb-text-muted);">Net Adjustments</span>
                    <span class="fw-semibold font-monospace" style="color:@(Model.NetAdjustments >= 0 ? "#22c55e" : "#ef4444");">
                        @(Model.NetAdjustments < 0 ? "-" : "")₱@Math.Abs(Model.NetAdjustments).ToString("N2")
                    </span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-3 border-bottom" style="border-color:rgba(255,255,255,0.06)!important;">
                    <span style="color:var(--zb-text-muted);">Net Investing</span>
                    <span class="fw-semibold font-monospace" style="color:var(--zb-text-muted);">₱0.00</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-3 border-bottom" style="border-color:rgba(255,255,255,0.06)!important;">
                    <span style="color:var(--zb-text-muted);">Net Financing</span>
                    <span class="fw-semibold font-monospace" style="color:var(--zb-text-muted);">₱0.00</span>
                </div>
                <div class="d-flex justify-content-between align-items-center pt-4">
                    <span class="fw-bold fs-6" style="color:var(--zb-text);">Net Change in Cash</span>
                    <span class="fw-bold fs-5 font-monospace" style="color:@(Model.NetCashChange >= 0 ? "#22c55e" : "#ef4444");">
                        @(Model.NetCashChange < 0 ? "-" : "")₱@Math.Abs(Model.NetCashChange).ToString("N2")
                    </span>
                </div>
                @if (Model.CashFromCustomers > 0)
                {
                    var cashMargin = Math.Round(Model.NetCashChange / Model.CashFromCustomers * 100m, 1);
                    <div class="mt-3 pt-3 border-top" style="border-color:rgba(255,255,255,0.06)!important;">
                        <div class="d-flex justify-content-between align-items-center">
                            <span style="color:var(--zb-text-muted);font-size:0.85rem;">Cash Margin</span>
                            <span class="fw-semibold" style="color:@(cashMargin >= 0 ? "#22c55e" : "#ef4444");font-size:0.85rem;">@cashMargin%</span>
                        </div>
                        <div class="progress mt-2" style="height:6px;background:rgba(255,255,255,0.06);">
                            <div class="progress-bar" role="progressbar"
                                 style="width:@Math.Abs(Math.Clamp(cashMargin, -100m, 100m))%;background:@(cashMargin >= 0 ? "#22c55e" : "#ef4444");"
                                 aria-valuenow="@Math.Abs(cashMargin)" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="zb-table-card mt-4 p-4">
            <div class="d-flex gap-2 mb-2">
                <i class="bi bi-info-circle" style="color:var(--zb-secondary);margin-top:2px;flex-shrink:0;"></i>
                <p class="mb-0 small" style="color:var(--zb-text-muted);">
                    Cash flow is derived from <strong style="color:var(--zb-text);">Payments</strong> (cash collected),
                    <strong style="color:var(--zb-text);">Order COGS</strong> (MenuItem cost × quantity), and
                    <strong style="color:var(--zb-text);">Adjustments</strong>. Investing and Financing sections will
                    populate when those transactions are recorded.
                </p>
            </div>
        </div>
    </div>
</div>
