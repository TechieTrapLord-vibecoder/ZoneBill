@model IEnumerable<ZoneBill_Lloren.Models.Order>
@using ZoneBill_Lloren.Helpers

@{
    ViewData["Title"] = "Orders";
    var search = ViewBag.Search as string;
    int? cashierId = ViewBag.CashierId == null ? null : (int)ViewBag.CashierId;
    var fromDate = ViewBag.FromDate as string;
    var toDate = ViewBag.ToDate as string;
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalOrders = (int)(ViewBag.TotalOrders ?? 0);
    var totalPortalOrders = (int)(ViewBag.TotalPortalOrders ?? 0);
    var totalItemLines = (int)(ViewBag.TotalItemLines ?? 0);
    var totalQtySold = (int)(ViewBag.TotalQtySold ?? 0);
    var totalMenuSales = (decimal)(ViewBag.TotalMenuSales ?? 0m);
    var cashiers = ViewBag.Cashiers as IEnumerable<SelectListItem>;
    var rowMetrics = ViewBag.RowMetrics as IDictionary<int, ZoneBill_Lloren.Models.OrderListRowMetrics>
        ?? new Dictionary<int, ZoneBill_Lloren.Models.OrderListRowMetrics>();
    string PageUrl(int nextPage) => Url.Action("Index", new { search, cashierId, fromDate, toDate, page = nextPage }) ?? "#";
    var paging = new ZoneBill_Lloren.Models.PagingInfo { CurrentPage = currentPage, TotalPages = totalPages, TotalCount = totalOrders, UrlTemplate = PageUrl(0).Replace("page=0", "page=__PAGE__") };
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-0" style="color:var(--zb-text);"><i class="bi bi-bag-check me-2" style="color:var(--zb-secondary);"></i>Orders</h4>
        <p class="text-muted small mb-0">Operational menu order ledger from POS and customer portal.</p>
    </div>
    <span class="zb-badge" style="background:rgba(6,182,212,0.12);color:var(--zb-secondary);border:1px solid rgba(6,182,212,0.3);">
        <i class="bi bi-robot me-1"></i>Orders captured via POS/Portal
    </span>
</div>

<div class="row row-cols-2 row-cols-lg-5 g-3 mb-4">
    <div class="col">
        <div class="zb-kpi-card" style="border-color:rgba(6,182,212,0.4);">
            <div class="zb-kpi-label">Total Orders</div>
            <div class="zb-kpi-value" style="color:var(--zb-secondary);">@totalOrders</div>
        </div>
    </div>
    <div class="col">
        <div class="zb-kpi-card">
            <div class="zb-kpi-label">Order Lines</div>
            <div class="zb-kpi-value">@totalItemLines</div>
        </div>
    </div>
    <div class="col">
        <div class="zb-kpi-card" style="border-color:rgba(34,197,94,0.4);">
            <div class="zb-kpi-label">Menu Qty Sold</div>
            <div class="zb-kpi-value" style="color:#22c55e;">@totalQtySold</div>
        </div>
    </div>
    <div class="col">
        <div class="zb-kpi-card" style="border-color:rgba(249,115,22,0.4);">
            <div class="zb-kpi-label">Menu Sales</div>
            <div class="zb-kpi-value" style="color:var(--zb-accent);">₱@totalMenuSales.ToString("N2")</div>
        </div>
    </div>
    <div class="col">
        <div class="zb-kpi-card" style="border-color:rgba(168,85,247,0.35);">
            <div class="zb-kpi-label">Portal Orders</div>
            <div class="zb-kpi-value" style="color:#c084fc;">@totalPortalOrders</div>
        </div>
    </div>
</div>

<form method="get" class="zb-table-card p-3 mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label for="ordersSearch" class="form-label small" style="color:var(--zb-text-muted);">Search</label>
            <input id="ordersSearch" type="text" name="search" value="@search" class="form-control zb-form-input" placeholder="Order ID, booking ID, cashier, reference, status" />
        </div>
        <div class="col-md-3">
            <label for="ordersCashier" class="form-label small" style="color:var(--zb-text-muted);">Cashier</label>
            <select id="ordersCashier" name="cashierId" class="form-select zb-form-input">
                <option value="">All cashiers</option>
                @if (cashiers != null)
                {
                    foreach (var cashier in cashiers)
                    {
                        <option value="@cashier.Value" selected="@(cashierId?.ToString() == cashier.Value ? "selected" : null)">@cashier.Text</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <label for="ordersFromDate" class="form-label small" style="color:var(--zb-text-muted);">From</label>
            <input id="ordersFromDate" type="date" name="fromDate" value="@fromDate" class="form-control zb-form-input" />
        </div>
        <div class="col-md-2">
            <label for="ordersToDate" class="form-label small" style="color:var(--zb-text-muted);">To</label>
            <input id="ordersToDate" type="date" name="toDate" value="@toDate" class="form-control zb-form-input" />
        </div>
        <div class="col-md-1 d-grid">
            <button type="submit" class="btn btn-sm fw-semibold" style="background:rgba(6,182,212,0.15);color:var(--zb-secondary);border:1px solid rgba(6,182,212,0.3);">Go</button>
        </div>
    </div>
</form>

<div class="zb-table-card">
    <div class="table-responsive">
        <table class="table zb-table mb-0">
            <thead>
                <tr>
                    <th>Booking Ref</th>
                    <th>Source</th>
                    <th>Cashier</th>
                    <th class="text-center">Items</th>
                    <th class="text-center">Qty</th>
                    <th class="text-end">Menu Total</th>
                    <th>Fulfillment</th>
                    <th>Order Time</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var m = rowMetrics.ContainsKey(item.OrderId)
                        ? rowMetrics[item.OrderId]
                        : new ZoneBill_Lloren.Models.OrderListRowMetrics();
                    var source = string.IsNullOrWhiteSpace(item.OrderSource) ? "POS" : item.OrderSource;
                    <tr>
                        <td class="fw-semibold" style="color:var(--zb-text);">
                            <div class="d-flex flex-column">
                                <span class="zb-mono">#@item.BookingId</span>
                                <span class="small" style="color:var(--zb-text-muted);">@item.Booking?.ReferenceCode</span>
                            </div>
                        </td>
                        <td>
                            @if (source == "Portal")
                            {
                                <span class="zb-badge" style="background:rgba(6,182,212,0.18);color:var(--zb-secondary);border:1px solid rgba(6,182,212,0.35);">Portal</span>
                            }
                            else
                            {
                                <span class="zb-badge" style="background:rgba(249,115,22,0.16);color:#fb923c;border:1px solid rgba(249,115,22,0.35);">POS</span>
                            }
                        </td>
                        <td>@item.Cashier?.EmailAddress</td>
                        <td class="text-center">@m.LineCount</td>
                        <td class="text-center">@m.TotalQty</td>
                        <td class="text-end zb-mono">₱@m.MenuTotal.ToString("N2")</td>
                        <td>
                            @if (m.LineCount == 0)
                            {
                                <span class="small" style="color:var(--zb-text-muted);">No items</span>
                            }
                            else if (m.UnservedLines > 0)
                            {
                                <span class="zb-badge" style="background:rgba(239,68,68,0.16);color:#fca5a5;border:1px solid rgba(239,68,68,0.35);">@m.UnservedLines pending</span>
                            }
                            else
                            {
                                <span class="zb-badge" style="background:rgba(34,197,94,0.16);color:#86efac;border:1px solid rgba(34,197,94,0.35);">All served</span>
                            }
                        </td>
                        <td><span class="zb-mono">@PhilippineTime.ToDateTime(item.OrderTime).ToString("MMM d, h:mm tt")</span></td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.OrderId" class="zb-action-btn" title="View Details"><i class="bi bi-eye"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination", paging)
</div>
