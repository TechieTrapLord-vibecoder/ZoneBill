@model IEnumerable<ZoneBill_Lloren.Models.SubscriptionInvoice>
@using ZoneBill_Lloren.Helpers
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Subscription Invoices";
    var businessOptions = ViewBag.BusinessOptions as List<SelectListItem> ?? new List<SelectListItem>();
    var planOptions = ViewBag.PlanOptions as List<SelectListItem> ?? new List<SelectListItem>();
    var currentStatus = (ViewBag.FilterStatus as string) ?? "All";
    var currentBusinessId = ViewBag.FilterBusinessId as int?;
    var currentPlanId = ViewBag.FilterPlanId as int?;
    var currentFromDate = ViewBag.FilterFromDate as string;
    var currentToDate = ViewBag.FilterToDate as string;
    var currentQ = ViewBag.FilterQ as string;
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages  = (int)(ViewBag.TotalPages  ?? 1);
    var totalCount  = (int)(ViewBag.TotalCount  ?? 0);
    var paging = new ZoneBill_Lloren.Models.PagingInfo {
        CurrentPage = currentPage, TotalPages = totalPages, TotalCount = totalCount,
        UrlTemplate = Url.Action("Index", new { status = currentStatus, businessId = currentBusinessId, planId = currentPlanId, fromDate = currentFromDate, toDate = currentToDate, q = currentQ, page = "__PAGE__" }) ?? "#"
    };
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-0" style="color:var(--zb-text);"><i class="bi bi-receipt me-2" style="color:var(--zb-secondary);"></i>Subscription Invoices</h4>
        <p class="text-muted small mb-0">SaaS billing history for all tenant businesses.</p>
    </div>
    <a asp-action="ExportCsv"
       asp-route-status="@currentStatus"
       asp-route-businessId="@currentBusinessId"
       asp-route-planId="@currentPlanId"
       asp-route-fromDate="@currentFromDate"
       asp-route-toDate="@currentToDate"
       asp-route-q="@currentQ"
       class="btn btn-sm fw-semibold" style="background:rgba(6,182,212,0.12);color:var(--zb-secondary);border:1px solid rgba(6,182,212,0.3);">
        <i class="bi bi-download me-1"></i> Export CSV
    </a>
</div>

<div class="zb-table-card mb-4">
    <div class="p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-12 col-md-2">
                <label for="statusFilter" class="form-label zb-form-label">Status</label>
                <select id="statusFilter" name="status" class="form-select zb-form-input">
                    @if (currentStatus == "All") { <option value="All" selected>All</option> } else { <option value="All">All</option> }
                    @if (currentStatus == "Paid") { <option value="Paid" selected>Paid</option> } else { <option value="Paid">Paid</option> }
                    @if (currentStatus == "Pending") { <option value="Pending" selected>Pending</option> } else { <option value="Pending">Pending</option> }
                    @if (currentStatus == "Failed") { <option value="Failed" selected>Failed</option> } else { <option value="Failed">Failed</option> }
                    @if (currentStatus == "Overdue") { <option value="Overdue" selected>Overdue</option> } else { <option value="Overdue">Overdue</option> }
                    @if (currentStatus == "Cancelled") { <option value="Cancelled" selected>Cancelled</option> } else { <option value="Cancelled">Cancelled</option> }
                </select>
            </div>
            <div class="col-12 col-md-2">
                <label for="businessFilter" class="form-label zb-form-label">Business</label>
                <select id="businessFilter" name="businessId" class="form-select zb-form-input">
                    <option value="">All</option>
                    @foreach (var opt in businessOptions)
                    {
                        if (currentBusinessId.HasValue && currentBusinessId.Value.ToString() == opt.Value)
                        {
                            <option value="@opt.Value" selected>@opt.Text</option>
                        }
                        else
                        {
                            <option value="@opt.Value">@opt.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 col-md-2">
                <label for="planFilter" class="form-label zb-form-label">Plan</label>
                <select id="planFilter" name="planId" class="form-select zb-form-input">
                    <option value="">All</option>
                    @foreach (var opt in planOptions)
                    {
                        if (currentPlanId.HasValue && currentPlanId.Value.ToString() == opt.Value)
                        {
                            <option value="@opt.Value" selected>@opt.Text</option>
                        }
                        else
                        {
                            <option value="@opt.Value">@opt.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label for="fromDateFilter" class="form-label zb-form-label">From</label>
                <input id="fromDateFilter" type="date" name="fromDate" value="@currentFromDate" class="form-control zb-form-input" />
            </div>
            <div class="col-6 col-md-2">
                <label for="toDateFilter" class="form-label zb-form-label">To</label>
                <input id="toDateFilter" type="date" name="toDate" value="@currentToDate" class="form-control zb-form-input" />
            </div>
            <div class="col-12 col-md-2">
                <label for="queryFilter" class="form-label zb-form-label">Search</label>
                <input id="queryFilter" type="text" name="q" value="@currentQ" class="form-control zb-form-input" placeholder="Business/ref/status" />
            </div>
            <div class="col-12 d-flex gap-2 mt-2">
                <button type="submit" class="btn btn-sm fw-semibold" style="background:var(--zb-accent);color:#fff;border:none;">
                    <i class="bi bi-funnel me-1"></i>Apply Filters
                </button>
                <a asp-action="Index" class="btn btn-sm fw-semibold" style="background:rgba(148,163,184,0.12);color:var(--zb-text-muted);border:1px solid rgba(148,163,184,0.3);">
                    Reset
                </a>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="zb-kpi-card" style="border-color:rgba(6,182,212,0.4);">
            <div class="zb-kpi-label">Total Invoices</div>
            <div class="zb-kpi-value" style="color:var(--zb-secondary);">@totalCount</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="zb-kpi-card" style="border-color:rgba(34,197,94,0.4);">
            <div class="zb-kpi-label">Paid</div>
            <div class="zb-kpi-value" style="color:#22c55e;">@(ViewBag.KpiPaid ?? 0)</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="zb-kpi-card" style="border-color:rgba(249,115,22,0.4);">
            <div class="zb-kpi-label">Pending</div>
            <div class="zb-kpi-value" style="color:var(--zb-accent);">@(ViewBag.KpiPending ?? 0)</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="zb-kpi-card" style="border-color:rgba(239,68,68,0.4);">
            <div class="zb-kpi-label">Failed / Overdue</div>
            <div class="zb-kpi-value" style="color:#ef4444;">@(ViewBag.KpiFailedOverdue ?? 0)</div>
        </div>
    </div>
</div>

<div class="zb-table-card">
    <div class="table-responsive">
        <table class="table zb-table mb-0">
            <thead>
                <tr>
                    <th>Issued (PH)</th>
                    <th>Business</th>
                    <th>Plan</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Period</th>
                    <th>Reference</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var invoice in Model)
                {
                    var statusBadge = invoice.Status switch
                    {
                        "Paid"      => "zb-badge-green",
                        "Pending"   => "zb-badge-cyan",
                        "Failed"    => "zb-badge-red",
                        "Overdue"   => "zb-badge-orange",
                        "Cancelled" => "zb-badge-yellow",
                        _           => "zb-badge-cyan"
                    };
                    <tr>
                        <td><span class="zb-mono">@PhilippineTime.ToDateTime(invoice.IssuedAt).ToString("MMM d, yyyy h:mm tt")</span></td>
                        <td class="fw-semibold" style="color:var(--zb-text);">@invoice.Business.BusinessName</td>
                        <td>@invoice.Plan.PlanName</td>
                        <td style="color:var(--zb-secondary);">@invoice.Amount.ToString("C")</td>
                        <td><span class="zb-badge @statusBadge">@invoice.Status</span></td>
                        <td><span class="zb-mono">@PhilippineTime.ToDateTime(invoice.PeriodStart).ToString("MMM d") – @PhilippineTime.ToDateTime(invoice.PeriodEnd).ToString("MMM d, yyyy")</span></td>
                        <td>@(string.IsNullOrEmpty(invoice.ExternalReference) ? "—" : invoice.ExternalReference)</td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-controller="Businesses" asp-action="Details" asp-route-id="@invoice.BusinessId" class="zb-action-btn" title="Open Business"><i class="bi bi-building"></i></a>
                                @if (invoice.Status == "Failed" || invoice.Status == "Overdue")
                                {
                                    <form asp-action="Retry" method="post" class="d-inline" onsubmit="return confirm('Retry this invoice and move it to Pending?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@invoice.SubscriptionInvoiceId" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit" class="zb-action-btn" title="Retry" style="color:var(--zb-accent);background:none;border:none;"><i class="bi bi-arrow-repeat"></i></button>
                                    </form>
                                }
                                @if (invoice.Status != "Paid")
                                {
                                    <form asp-action="MarkPaid" method="post" class="d-inline" onsubmit="return confirm('Mark this invoice as Paid?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@invoice.SubscriptionInvoiceId" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit" class="zb-action-btn" title="Mark Paid" style="color:#22c55e;background:none;border:none;"><i class="bi bi-check2-circle"></i></button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination", paging)
</div>
