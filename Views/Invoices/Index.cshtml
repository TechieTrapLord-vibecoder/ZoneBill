@model IEnumerable<ZoneBill_Lloren.Models.Invoice>
@using ZoneBill_Lloren.Helpers

@{
    ViewData["Title"] = "Invoices";
    var today = PhilippineTime.Now.Date;
    var totalAmt = (decimal)(ViewBag.TotalRevenue ?? 0m);
    var paid = (int)(ViewBag.PaidCount ?? 0);
    var unpaid = (int)(ViewBag.UnpaidCount ?? 0);
    var overdue = (int)(ViewBag.OverdueCount ?? 0);
    var search = ViewBag.Search as string;
    var status = ViewBag.Status as string;
    var fromDate = ViewBag.FromDate as string;
    var toDate = ViewBag.ToDate as string;
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    string StatusUrl(string? nextStatus) => Url.Action("Index", new { search, status = nextStatus, fromDate, toDate, page = 1 }) ?? "#";
    string PageUrl(int nextPage) => Url.Action("Index", new { search, status, fromDate, toDate, page = nextPage }) ?? "#";
    var paging = new ZoneBill_Lloren.Models.PagingInfo { CurrentPage = currentPage, TotalPages = totalPages, TotalCount = totalCount, UrlTemplate = PageUrl(0).Replace("page=0", "page=__PAGE__") };
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-0" style="color:var(--zb-text);"><i class="bi bi-receipt-cutoff me-2" style="color:var(--zb-secondary);"></i>Invoices</h4>
        <p class="text-muted small mb-0">Billing records for all completed sessions.</p>
    </div>
    <span class="zb-badge" style="background:rgba(6,182,212,0.12);color:var(--zb-secondary);border:1px solid rgba(6,182,212,0.3);">
        <i class="bi bi-robot me-1"></i>Auto-generated from checkout
    </span>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="zb-kpi-card" style="border-color:rgba(6,182,212,0.4);">
            <div class="zb-kpi-label">Total Revenue</div>
            <div class="zb-kpi-value" style="color:var(--zb-secondary);">@totalAmt.ToString("C")</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="zb-kpi-card" style="border-color:rgba(34,197,94,0.4);">
            <div class="zb-kpi-label">Paid</div>
            <div class="zb-kpi-value" style="color:#22c55e;">@paid</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="zb-kpi-card" style="border-color:rgba(249,115,22,0.4);">
            <div class="zb-kpi-label">Unpaid</div>
            <div class="zb-kpi-value" style="color:var(--zb-accent);">@unpaid</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="zb-kpi-card" style="border-color:rgba(239,68,68,0.4);">
            <div class="zb-kpi-label">Overdue (&gt;3 days)</div>
            <div class="zb-kpi-value" style="color:#ef4444;">@overdue</div>
        </div>
    </div>
</div>

<form method="get" class="zb-table-card p-3 mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label small" style="color:var(--zb-text-muted);">Search</label>
            <input type="text" name="search" value="@search" class="form-control zb-form-input" placeholder="Invoice ID, booking ID, reference, status" />
        </div>
        <div class="col-md-2">
            <label class="form-label small" style="color:var(--zb-text-muted);">From</label>
            <input type="date" name="fromDate" value="@fromDate" class="form-control zb-form-input" />
        </div>
        <div class="col-md-2">
            <label class="form-label small" style="color:var(--zb-text-muted);">To</label>
            <input type="date" name="toDate" value="@toDate" class="form-control zb-form-input" />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <input type="hidden" name="status" value="@status" />
            <button type="submit" class="btn btn-sm fw-semibold flex-grow-1" style="background:rgba(6,182,212,0.15);color:var(--zb-secondary);border:1px solid rgba(6,182,212,0.3);">
                <i class="bi bi-search me-1"></i>Apply
            </button>
            <a href="@Url.Action("Index")" class="btn btn-sm" style="background:rgba(255,255,255,0.06);color:var(--zb-text-muted);border:1px solid rgba(255,255,255,0.1);">Reset</a>
        </div>
    </div>
</form>

<div class="d-flex gap-2 mb-3">
    <a href="@StatusUrl(null)" class="zb-badge text-decoration-none" style="cursor:pointer;padding:4px 14px;border-radius:20px;border:1px solid rgba(6,182,212,0.35);background:@(string.IsNullOrWhiteSpace(status) ? "rgba(6,182,212,0.15)" : "transparent");color:@(string.IsNullOrWhiteSpace(status) ? "var(--zb-secondary)" : "#94a3b8");">All</a>
    <a href="@StatusUrl("Paid")" class="zb-badge text-decoration-none" style="cursor:pointer;padding:4px 14px;border-radius:20px;border:1px solid rgba(34,197,94,0.35);background:@(status == "Paid" ? "rgba(34,197,94,0.15)" : "transparent");color:@(status == "Paid" ? "#22c55e" : "#94a3b8");">Paid</a>
    <a href="@StatusUrl("Unpaid")" class="zb-badge text-decoration-none" style="cursor:pointer;padding:4px 14px;border-radius:20px;border:1px solid rgba(249,115,22,0.35);background:@(status == "Unpaid" ? "rgba(249,115,22,0.15)" : "transparent");color:@(status == "Unpaid" ? "var(--zb-accent)" : "#94a3b8");">Unpaid</a>
    <a href="@StatusUrl("overdue")" class="zb-badge text-decoration-none" style="cursor:pointer;padding:4px 14px;border-radius:20px;border:1px solid rgba(239,68,68,0.35);background:@(status == "overdue" ? "rgba(239,68,68,0.15)" : "transparent");color:@(status == "overdue" ? "#ef4444" : "#94a3b8");">Overdue</a>
</div>

<form asp-action="BulkMarkPaid" method="post" id="bulkPaidForm">
    @Html.AntiForgeryToken()
    <div class="zb-table-card">
        <div class="px-4 pt-3 pb-2 border-bottom d-flex align-items-center justify-content-between" style="border-color:rgba(6,182,212,0.15)!important;">
            <div class="d-flex align-items-center gap-2">
                <input type="checkbox" id="selectAll" style="width:15px;height:15px;accent-color:var(--zb-secondary);">
                <label for="selectAll" class="mb-0 small" style="color:var(--zb-text-muted);cursor:pointer;">Select all</label>
            </div>
            <button type="submit" id="bulkPaidBtn" class="btn btn-sm fw-semibold" style="background:rgba(34,197,94,0.15);color:#22c55e;border:1px solid rgba(34,197,94,0.3);display:none;">
                <i class="bi bi-check2-all me-1"></i> Mark Selected as Paid
            </button>
        </div>
        <div class="table-responsive">
            <table class="table zb-table mb-0">
                <thead>
                    <tr>
                        <th style="width:36px;"></th>
                        <th>Invoice No</th>
                        <th>Business</th>
                        <th>Booking</th>
                        <th>Total</th>
                        <th>Tax</th>
                        <th>Status</th>
                        <th>Generated</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var statusClass = item.PaymentStatus == "Paid" ? "zb-badge-green" : "zb-badge-orange";
                        var isPaid = item.PaymentStatus == "Paid";
                        var isOverdue = !isPaid && PhilippineTime.ToDateTime(item.GeneratedDate).Date < today.AddDays(-3);
                        var rowStyle = isOverdue ? "background:rgba(239,68,68,0.06);border-left:3px solid rgba(239,68,68,0.5);" : "";
                        <tr data-status="@item.PaymentStatus" data-overdue="@isOverdue.ToString().ToLower()" style="@rowStyle">
                            <td>
                                @if (!isPaid)
                                {
                                    <input type="checkbox" name="invoiceIds" value="@item.InvoiceId" class="inv-chk"
                                           style="width:15px;height:15px;accent-color:var(--zb-secondary);">
                                }
                            </td>
                            <td class="fw-semibold" style="color:var(--zb-text);">@item.Business?.BusinessName</td>
                            <td><span class="zb-mono" style="color:var(--zb-secondary);font-size:.78rem;">@(string.IsNullOrEmpty(item.InvoiceNumber) ? $"#{item.InvoiceId}" : item.InvoiceNumber)</span></td>
                            <td>@item.Booking?.BookingStatus</td>
                            <td class="fw-semibold" style="color:var(--zb-secondary);">@item.TotalAmount.ToString("C")</td>
                            <td>@item.TaxRateApplied.ToString("0.##")%</td>
                            <td>
                                <span class="zb-badge @statusClass">@item.PaymentStatus</span>
                                @if (isOverdue) { <span class="zb-badge" style="background:rgba(239,68,68,0.12);color:#ef4444;border:1px solid rgba(239,68,68,0.3);font-size:.65rem;margin-left:4px;">Overdue</span> }
                            </td>
                            <td><span class="zb-mono">@PhilippineTime.ToDateTime(item.GeneratedDate).ToString("MMM d, h:mm tt")</span></td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-action="Details" asp-route-id="@item.InvoiceId" class="zb-action-btn" title="View"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Receipt" asp-route-id="@item.InvoiceId" target="_blank" class="zb-action-btn" title="Print Receipt"><i class="bi bi-printer"></i></a>
                                    @if (!isPaid)
                                    {
                                        <a asp-action="Details" asp-route-id="@item.InvoiceId" class="zb-action-btn" title="Receive Payment" style="color:#22c55e;"><i class="bi bi-cash-coin"></i></a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_Pagination", paging)
    </div>
</form>

@section Scripts {
<script>
(function () {
    var selectAll = document.getElementById('selectAll');
    var bulkBtn = document.getElementById('bulkPaidBtn');
    function updateBulkBtn() {
        var checked = document.querySelectorAll('.inv-chk:checked').length;
        bulkBtn.style.display = checked > 0 ? '' : 'none';
        bulkBtn.textContent = '';
        bulkBtn.innerHTML = '<i class="bi bi-check2-all me-1"></i> Mark ' + checked + ' as Paid';
    }
    if (selectAll) {
        selectAll.addEventListener('change', function () {
            document.querySelectorAll('.inv-chk').forEach(function (c) { c.checked = selectAll.checked; });
            updateBulkBtn();
        });
    }
    document.querySelectorAll('.inv-chk').forEach(function (c) {
        c.addEventListener('change', updateBulkBtn);
    });
    document.getElementById('bulkPaidForm')?.addEventListener('submit', function (event) {
        if (document.querySelectorAll('.inv-chk:checked').length === 0) {
            event.preventDefault();
            return;
        }
        if (!confirm('Create payment and journal records for the selected invoices?')) {
            event.preventDefault();
        }
    });
})();
</script>
}